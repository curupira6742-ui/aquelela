-- Vetor -> array de 3 numeros. O overlay le como lista simples; mandar
-- Vector3 cru nao sobrevive ao JSON de forma confiavel.
local function vec(v)
    return {v.X, v.Y, v.Z}
end

-- Extrai a matriz da camera como 4 vetores. Com isto o overlay projeta
-- qualquer ponto do mundo sozinho:
--     local = (P - pos) . RightVector / . UpVector / . LookVector
--     profundidade = componente no LookVector
--     x = cx + (localX / prof) * escala
--     y = cy - (localY / prof) * escala
--     escala = (altura/2) / tan(fovVertical/2)
local function cameraData(cam)
    if not cam then return nil end
    local cf = cam.CFrame
    local ok, fov = pcall(function() return cam.FieldOfView end)
    return {
        pos = vec(cf.Position),
        right = vec(cf.RightVector),
        up = vec(cf.UpVector),
        look = vec(cf.LookVector),
        fov = ok and fov or 70,
        -- Campo de visao vertical e' o que o Roblox usa; o overlay deriva
        -- o horizontal pela proporcao do viewport.
        viewport = {cam.ViewportSize.X, cam.ViewportSize.Y},
    }
end

-- [DESEMPENHO -- o ponto mais caro de todos] Cada leitura de .CFrame nao
-- devolve um valor solto: o executor tem de MATERIALIZAR um objeto
-- CFrame/UserData por leitura. Medido no Roblox (BM_CFRAME):
--     vetor cru              0,60 ms / 100.000
--     CFrame materializado   0,60 ms / 100.000  (custo de pilha)
--     VARREDURA COMPLETA     0,88 ms /  60.000  (formata TODOS os campos)
-- So' fazer `c.X` num CFrame ja' NEWINDEXado custava 1,48 ms por 60.000 --
-- 10x o custo do CFrame ja' estar ali. Com 10 partes por alvo e ~3 alvos
-- isso e' ~35 leituras de .CFrame POR QUADRO, cada uma com 3 campos lidos:
-- mais de 100 materializacoes de UserData por quadro, so' para produzir
-- numeros IDENTICOS aos do quadro anterior com um objeto parado.
--
-- Aqui a leitura passa a acontecer UMA vez por parte: o slot guarda
-- part mais os numeros ja' extraidos. A partir do 2o quadro de vida de um
-- slot NAO HA' NENHUM acesso a .CFrame: os numeros sao RE-EMITIDOS das
-- NVIs ja' armazenadas (o caminho barato, 0,60 ms/100.000) e
-- GetPivot()/GetPartsObsolete() sao o unico caminho de sync.
-- [OTIMIZACAO 2] Este slot ja' mandou o tamanho desta parte recentemente?
--
-- O slot e' por (alvo, parte) e sobrevive entre pacotes, entao e' o lugar
-- natural para a marca. `agoraPacote` e' o relogio do pacote em curso --
-- passado de fora para nao haver uma leitura de os.clock por parte.
local function precisaTamanho(sl, agoraPacote)
    if not sl.sEm or (agoraPacote - sl.sEm) >= REENVIO_S then
        sl.sEm = agoraPacote
        return true
    end
    return false
end

