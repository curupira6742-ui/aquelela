-- Aplica um dict vindo do ui_cache.json. Tolerante a lixo: campo ausente,
-- tipo errado ou arquivo antigo (sem `otim`) nao mudam nada e nao levantam
-- erro. O coletor nunca pode cair por causa de um flag malformado.
function OTIM.aplica(t)
    if type(t) ~= "table" then return end
    -- So' as TRES que existem. "partes" foi medida e descartada (ver o
    -- comentario da tabela OTIM); o servidor nao a publica mais, e aceitar
    -- a chave aqui daria a impressao de que ela faz alguma coisa.
    for _, chave in ipairs({"rotacao", "indice", "delta",
                            "quant", "sig", "tela", "partes", "bin", "ws",
                            "vis"}) do
        local v = t[chave]
        if type(v) == "boolean" then
            OTIM[chave] = v
        end
    end
    -- `hz` e' numero, nao booleano: o teto de envio vem do slider da aba.
    -- Faixa aceita 0 (sem teto) ou 5..240; fora disso e' lixo e fica como
    -- estava, para um valor malformado nunca emudecer o coletor.
    local hz = tonumber(t.hz)
    if hz and (hz == 0 or (hz >= 5 and hz <= 240)) then
        OTIM.hz = hz
    end
end

-- =====================================================================
-- [DIAGNOSTICO REMOVIDO]
--
-- Havia aqui um bloco `enviaDiag` que gravava DIAG_OTIM.txt 1x por segundo
-- para permitir ver o estado do coletor de fora do jogo. Ele cumpriu o
-- papel durante a investigacao e foi REMOVIDO desta versao:
--
--   1) Escrevia arquivo a 1 Hz dentro do RenderStep, custo sem retorno em
--      operacao normal.
--   2) Foi a origem de um bug serio quando ficou ANTES do bloco OTIM: em
--      Lua uma `local` so' existe a partir da linha da declaracao, entao
--      `OTIM.rotacao` resolvia para um global nil e levantava erro a 60x/s
--      de dentro do BindToRenderStep -- o coletor inteiro parava.
--
-- O estado do coletor continua visivel pelo campo `packet` (sent, skipped,
-- failReason, buildErr), que o painel em jogo mostra. Se precisar de novo
-- diagnostico em arquivo, ele deve vir DEPOIS de tudo o que ele le'.
-- =====================================================================

-- Releitura periodica. O discoverBridge so' le' o ui_cache.json enquanto
-- bridgeReady for falso -- depois que ele descobre a porta, NUNCA mais
-- rela. Entao, sem isto, mexer num switch do painel so' teria efeito se
-- o usuario reiniciasse o Lua. Aqui o arquivo e' relido a cada
-- OTIM.RECARGA segundos (2 s), no maximo, e so' o campo `otim` e' usado.
OTIM.RECARGA = 2.0
local otimProximaLeitura = 0

function OTIM.recarrega()
    if type(readfile) ~= "function" then return end
    local agora = os.clock()
    if agora < otimProximaLeitura then return end
    otimProximaLeitura = agora + OTIM.RECARGA
    for _, path in ipairs(statePaths()) do
        local ok, raw = pcall(readfile, path)
        if ok and type(raw) == "string" and #raw > 0 and #raw <= CFG_LOCAL.MAX_ESTADO then
            local okd, data = pcall(function()
                return HttpService:JSONDecode(raw)
            end)
            if okd and type(data) == "table" and type(data.otim) == "table" then
                OTIM.aplica(data.otim)
                return
            end
        end
    end
end

-- =====================================================================
-- DESCOBERTA (porta + token)
--
-- O servidor.py grava ui_cache.json no caminho canonico E em cada workspace
-- de executor, porque o readfile do sandbox e' RELATIVO a' pasta de trabalho.
-- Por isso a lista abaixo mistura caminhos relativos (para o sandbox) com o
-- absoluto (quando o executor expoe LOCALAPPDATA via getgenv).
--
-- Ordem: os mais provaveis primeiro. Custa ~microssegundos por tentativa e
-- so' roda quando ainda nao ha' ponte ou quando ela caiu.
-- =====================================================================

-- [COMPATIBILIDADE COM O SERVIDOR]
-- O overlay publica `proto` no ui_cache.json. Se o numero nao for este, o
-- servidor do outro lado le' um FORMATO diferente do que este arquivo monta:
-- o POST ainda devolveria 204 e nada seria desenhado, que e' a pior falha
-- possivel (tudo verde, tela vazia). Melhor recusar a ponte e dizer o motivo.
--
-- `proto` ausente = servidor anterior a este contrato: aceita, porque o
-- formato v2 e' justamente o que ele fala.
local PROTO_ESPERADO = 4

local function discoverBridge()
    if type(readfile) ~= "function" then
        bridgeFailReason = "readfile indisponivel neste executor"
        return false
    end
    for _, path in ipairs(statePaths()) do
        local ok, raw = pcall(readfile, path)
        if ok and type(raw) == "string" and #raw > 0 and #raw <= CFG_LOCAL.MAX_ESTADO then
            local decodificou, data = pcall(function()
                return HttpService:JSONDecode(raw)
            end)
            if decodificou and type(data) == "table" then
                local porta = tonumber(data.port)
                local token = data.token
                -- Mesmas validacoes do bloco original, mais uma: o `pid`
                -- precisa existir. O servidor.py sempre publica o pid, e a
                -- presenca dele distingue o formato novo de um ui_cache.json
                -- velho de outra ferramenta.
                local proto = tonumber(data.proto)
                if proto and proto ~= PROTO_ESPERADO then
                    bridgeFailReason = string.format(
                        "servidor fala proto v%d, este coletor e v%d -- ",
                        proto, PROTO_ESPERADO)
                elseif porta and porta >= 1024 and porta <= 65535
                   and type(token) == "string" and #token >= 32 then
                    bridgePort, bridgeToken, bridgeReady = porta, token, true
                    bridgeFailReason = nil
                    bridgeFalhas = 0
                    -- [ABA CONFIG] Flags de otimizacao vindos do painel do
                    -- overlay, no MESMO arquivo que ja' traz porta e token.
                    -- Nao ha' requisicao extra: e' uma leitura de tabela na
                    -- leitura que ja' acontecia.
                    --
                    -- Repare que isto NAO fica so' aqui: o discoverBridge so'
                    -- roda uma vez (o arquivo e' lido no maximo 1x por
                    -- segundo, e apenas enquanto bridgeReady for falso). Por
                    -- isso o OTIM.recarrega() abaixo e' chamado nos dois
                    -- lugares. Ver o bloco do OTIM.
                    OTIM.aplica(data.otim)
                    return true
                else
                    bridgeFailReason = "ui_cache.json invalido (porta/token)"
                end
            else
                bridgeFailReason = "ui_cache.json nao e' JSON valido"
            end
        end
    end
    bridgeFailReason = bridgeFailReason
        or "ui_cache.json nao encontrado no workspace"
    return false
end

local function bridgeURL(path)
    return "http://127.0.0.1:" .. tostring(bridgePort) .. path
end

local function bridgeHeaders(extra)
    local h = {["X-VS-Token"] = bridgeToken}
    if extra then
        -- [POR QUE `do ... end` NUMA LINHA]
        -- Em Lua, `for k,v in pairs(t) do corpo end` e' UM bloco: o `for` e o
        -- `do` sao a MESMA construcao, e o `end` fecha os dois. Escrever o
        -- `do` no fim da linha e o `end` no fim do corpo e' o estilo normal,
        -- mas aqui ficou tudo numa linha so' porque o corpo e' uma atribuicao.
        -- Isto NAO muda a contagem de blocos do Lua -- muda a de qualquer
        -- contador ingenuo que trate `for` e `do` como duas aberturas.
        for k, v in pairs(extra) do h[k] = v end
    end
    return h
end

-- =====================================================================
-- sendBridge -- MESMA ASSINATURA do original:
--
--     sendBridge(function() return body, assinatura end)
--
-- As TRES portas baratas, na ordem, antes de qualquer trabalho caro:
--
--   1. bridgeBusy    -- um POST em voo por vez. Sem isto, o numero de
--                      conexoes cresce sem limite e o servidor enfileira
--                      pacotes que ja' nasceram velhos.
--   2. bridgeReady   -- sem porta/token nao ha' para onde mandar. Redescobre
--                      no maximo 1x por segundo, e nao a cada quadro.
--   3. assinatura    -- o pacote e' byte a byte igual ao ultimo ENVIADO? entao
--                      nao ha' o que mandar. Este e' o portao que mais
--                      economiza: um jogador parado com a camera parada gera
--                      ZERO trafego, e o custo do JSONEncode nem e' pago.
--
-- O THUNK existe por causa da porta 3: quem chama devolve o corpo e a
-- assinatura, e o encode so' acontece depois que as tres portas passaram.
-- =====================================================================
-- [O BUG QUE MATOU O COLETOR -- FORWARD DECLARATION]
--
-- Medido com marco: o corpo do task.spawn roda, o encode termina
-- (`Y2:encode_ok len=1261`), e o marco seguinte (`Z:wsEnvia=...`) NUNCA
-- aparece. Entre os dois existe UMA linha:
--
--     local _wsOk = wsEnvia(encoded, usaBin)
--
-- E o `wsEnvia` e' declarado com `local function` na LINHA 2285 -- 1400
-- linhas DEPOIS. Em Lua, um `local function` so' existe a partir da sua
-- declaracao: na linha 851 o nome resolve para o GLOBAL, que e' nil. A
-- chamada levanta "attempt to call a nil value".
--
-- O erro mata o `task.spawn` inteiro ANTES do `bridgeBusy = false`, entao:
--   - o POST nunca roda
--   - `bridgeBusy` fica true para sempre (o ciclo U/W do watchdog)
--   - `sent=0` e `falhas=0`, porque nenhum dos dois caminhos e' alcancado
--   - `received` no servidor congela, com o loop VIVO
--
-- O `pcall(task.spawn, ...)` NAO pega isso: o corpo roda em outra thread e
-- o erro morre dentro dela. Por isso ficou invisivel por tantas injecoes.
--
-- A correcao e' um forward: o nome passa a existir ANTES do uso, e a
-- definicao real (linha 2285) sobrescreve o corpo. `OTIM.ws = false` por
-- padrao, entao o `wsEnvia` de verdade nem e' chamado -- mas agora ele
-- EXISTE quando a linha 851 executa.
local wsEnvia

local function sendBridge(build)

    if not bridgeReady then
        local agora = os.clock()
        if agora >= bridgeNextDiscover then
            bridgeNextDiscover = agora + CFG_LOCAL.REDESCOBRIR
            discoverBridge()
        end
        if not bridgeReady then return end
    end

    if bridgeBusy then
        -- O POST anterior ainda esta' em voo. Se este numero cresce sozinho,
        -- o gargalo e' a latencia do HttpService, nao o agendamento.
        bridgeDropped = bridgeDropped + 1

    end

    -- [BUG CORRIGIDO -- AUTO-REFERENCIA DO `local`]
    --
    -- Era:  local request = (syn and syn.request) or http_request or request
    --
    -- Em Lua, o `local` entra em escopo na PROPRIA linha da declaracao, antes
    -- de o inicializador ser avaliado. Entao o `request` do FIM da expressao
    -- NAO e' o global: e' o local recem-criado, que ainda vale nil. A linha
    -- equivale a:
    --
    --     local request = (syn and syn.request) or http_request or nil
    --
    -- Enquanto `http_request` existir, o `or` resolve e nada quebra -- foi por
    -- isso que o bug ficou latente. Mas num executor que exponha APENAS o
    -- global `request` (sem `syn` e sem `http_request`), a expressao inteira
    -- vira nil, o `type(request) ~= "function"` abaixo dispara e o coletor
    -- faz `return` em silencio: `received` nunca sobe, nenhum erro aparece,
    -- e o overlay fica em branco para sempre.
    --
    -- A correcao nomeia o global explicitamente com `_G.request`, que nao
    -- depende de resolucao de escopo. A ordem de preferencia continua igual.
    local request = (syn and syn.request) or http_request
                    or (http and http.request) or _G.request
    if type(request) ~= "function" then
        bridgeFailReason = "request indisponivel neste executor"
        return
    end

    local agora = os.clock()
    if agora < bridgeNextSend then
        bridgeSkipped = bridgeSkipped + 1

        return
    end

    local okBuild, body, assinatura = pcall(build)
    if not okBuild then
        -- Um erro de montagem nao pode ser silencioso para sempre: ele vai
        -- no campo de diagnostico que o painel mostra.
        bridgeBuildErr = tostring(body)
        return
    end
    if type(body) ~= "table" then
        -- [SAIDA MUDA]
        --
        -- Este `return` nao incrementa `skipped` nem grava `bridgeBuildErr`.
        -- E' o unico caminho do sendBridge que sai COMPLETAMENTE calado. O
        -- sintoma medido -- `skipped` congelado, `buildErr` nil, zero pacote,
        -- loop vivo -- e' exatamente este.
        return
    end

    if assinatura ~= nil and assinatura == bridgeLastSig then
        bridgeSkipped = bridgeSkipped + 1

        return
    end

    -- ["hz"] Teto vindo do slider. O intervalo base e' PISO: o slider so'
    -- diminui a cadencia, nunca acelera alem do projetado. 0 = sem teto.
    local passo = CFG_LOCAL.INTERVALO
    if OTIM.hz and OTIM.hz > 0 and (1 / OTIM.hz) > passo then
        passo = 1 / OTIM.hz
    end
    bridgeNextSend = agora + passo
    bridgeBusy = true

    -- [THREAD DO POST]
    --
    -- Medido na v14: `sent=0` e `falhas=0` para sempre. Nenhum sucesso e
    -- NENHUM erro. Isso so' acontece se o corpo abaixo nunca executa --
    -- os tres `bridgeBusy = false` estao' em caminhos que exigem execucao.
    --
    -- Sem one-shot: grava TODA vez. O arquivo cresce ~2 linhas por envio,
    -- e o envio e' 1 por passo (nao por quadro), entao isto nao inunda.


    pcall(task.spawn, function()
        -- [CORPO DO POST]
        -- O encode sai da thread do RenderStep: a 60/s, serializar o pacote
        -- inteiro (ate' 100 alvos com 15 partes cada) na thread de render
        -- apareceria como engasgo de quadro.
        -- ["bin"] Binario quando o painel pede E o executor expoe
        -- string.pack. Sem o segundo teste, ligar a flag num executor sem
        -- pack daria erro a 60 Hz aqui dentro; com o JSON de reserva, o pior
        -- caso e' continuar exatamente como antes.
        local usaBin = OTIM.bin and TEM_PACK
        local okEncode, encoded = pcall(function()
            if usaBin then return montaBinario(body) end
            return HttpService:JSONEncode(body)
        end)
        if not okEncode or type(encoded) ~= "string" then
            bridgeBuildErr = "JSONEncode: " .. tostring(encoded)
            bridgeBusy = false
            return
        end

        -- [O HEADER `X-VS-Sig` CAUSAVA 403 -- REMOVIDO]
        --
        -- O transporte mandava `["X-VS-Sig"] = assinatura`. Medido, com o
        -- MESMO corpo e o MESMO token:
        --
        --     com X-VS-Sig   -> 403 Forbidden
        --     sem X-VS-Sig   -> 204 No Content
        --     so' X-VS-Token -> 204 No Content
        --
        -- Nenhum consumidor le' esse header: no servidor.py ele nao aparece
        -- uma unica vez (`VS-Sig` so' casa com `signal.SIGINT`/`SIGTERM`), o
        -- ponte_servidor.py nao o menciona, e o proprio servidor.py:247 diz
        -- "NAO responde 401/403". O 403 vem do `http_request` do executor,
        -- que barra a requisicao antes de ela sair.
        --
        -- O efeito era o pior possivel: o POST voltava com `ok = true` e
        -- `StatusCode = 403`, o `bridgeLastSig` era gravado na mesma linha
        -- (420), e a partir dali o portao de assinatura descartava todo
        -- pacote por "igual ao ultimo" -- `bridgeSent` ficava em 0 para
        -- sempre e `bridgeSkipped` subia sem parar. O sintoma visivel era
        -- `received` congelado no servidor e nenhum alvo no overlay.
        -- ["ws"] Tenta o cano aberto primeiro. Falhou por qualquer motivo --
        -- sem API, conexao caida, sem base64 -- o POST abaixo roda como
        -- sempre rodou. O WS nunca pode ser ponto unico de falha do canal.
        -- [WS ANTES DO POST]
        --
        -- Medido na v18: o corpo do POST roda, o encode devolve 2,3 KB, e
        -- NENHUM `Y3` aparece. Entre o `Y2` e o `Y3` existe UMA chamada: o
        -- `wsEnvia`. Ele devolve `true` (o `pcall` de `Send` nao levanta) e
        -- o `return` abaixo aborta o POST. O servidor nunca recebe -- e o
        -- `bridgeSent` sobe, escondendo a falha.
        --
        -- O POST e' o canal PROVADO (o teste externo subiu `received` de
        -- 11164 para 11165). O WS e' o suspeito. Este marco registra os
        -- dois lados para eu nao depender de inferencia.
        local _wsOk = wsEnvia(encoded, usaBin)
        if _wsOk then
            bridgeBusy = false
            bridgeSent = (bridgeSent or 0) + 1
            if assinatura ~= nil then bridgeLastSig = assinatura end
            return
        end

        local ok, response = pcall(request, {
            Url = bridgeURL("/esp"),
            Method = "POST",
            Headers = bridgeHeaders({
                ["Content-Type"] = usaBin and "application/octet-stream"
                                   or "application/json",
            }),
            Body = encoded,
        })

        bridgeBusy = false
        if not ok then
            -- Falha de rede: o servidor pode ter sido reiniciado e a porta
            -- ter mudado. Forca a redescoberta no proximo quadro.
            bridgeFalhas = bridgeFalhas + 1
            bridgeFailReason = "falha de rede: " .. tostring(response)
            if bridgeFalhas >= 3 then
                bridgeReady = false
                bridgeNextDiscover = 0
            end
            return
        end

        if assinatura ~= nil then bridgeLastSig = assinatura end

        local code = response and (response.StatusCode or response.Status)
        if code == 204 or code == 200 then
            bridgeSent = bridgeSent + 1
            bridgeFalhas = 0
            bridgeFailReason = nil
        elseif code == 404 then
            -- 404 aqui tem DOIS significados possiveis, e ambos pedem a
            -- mesma acao:
            --   a) token ou porta mudaram (servidor reiniciado);
            --   b) o servidor rejeitou o pacote por formato invalido -- o
            --      vs_secure_server.py devolve 404 generico nesse caso
            --      (o _deny() cobre tanto "sem token" quanto "ValueError").
            -- Em ambos, redescobrir e limpar a assinatura e' o certo: o
            -- proximo quadro TEM de ser enviado, porque um servidor
            -- recem-nascido nunca viu o ultimo pacote.
            bridgeReady = false
            bridgeNextDiscover = 0
            bridgeLastSig = nil
            bridgeFailReason = "404 -- token/porta mudaram ou pacote recusado"
        elseif code == 500 then
            -- Erro nao previsto do lado do servidor. Continuar tentando e'
            -- inutil ate' alguem olhar o log dele.
            bridgeFailReason = "500 do servidor (ver o console dele)"
        else
            bridgeFailReason = "HTTP " .. tostring(code)
        end
    end)
end

