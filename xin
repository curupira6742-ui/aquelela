-- MATRIX OBSIDIAN / COLETOR PURO
-- =====================================================================
-- Este script NAO desenha nada e NAO move nada. Ele so' LE o mundo do
-- Roblox e envia por HTTP local para o overlay do Windows.
--
-- Toda a inteligencia mora no overlay (Python):
--   - projecao 3D -> 2D (caixa, esqueleto, nomes, HP)
--   - escolha do alvo da mira (FOV, prioridade, team check, wall check)
--   - movimento do mouse (SendInput humanizado)
--
-- O que este arquivo faz, e so' isso:
--   1. descobre porta e token do overlay (ui_cache.json no workspace)
--   2. rastreia jogadores e NPCs (modelo, dono, vida, time, partes)
--   3. envia a posicao 3D das partes + a matriz da camera + viewport
--
-- NAO HA: ScreenGui, menu, caixas, nomes, esqueleto, circulo de FOV,
-- rotacao de camera, click, KeyDown ou qualquer alteracao no jogo.
--
-- O envio e' somente leitura do mundo. O servidor do jogo nao recebe
-- nada: a conversa e' 127.0.0.1 (loopback), do cliente para o overlay.
-- =====================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
-- [ESPERAR, NAO DESISTIR] Era `if not player then return end`. Injetado com
-- o cliente em "Loading...", LocalPlayer e' nil e o coletor desistia em
-- silencio -- execute:ok e zero pacote para sempre. Agora espera o jogador,
-- o DataModel carregado e a camera. Roda na thread do proprio script.
local espera = (task and task.wait) or wait
local player = Players.LocalPlayer
if not player then
    local t0 = os.clock()
    repeat
        espera(0.25)
        player = Players.LocalPlayer
    until player or (os.clock() - t0) > 90
    if not player then return end
end
if not game:IsLoaded() then
    pcall(function() game.Loaded:Wait() end)
end
if not Workspace.CurrentCamera then
    local t1 = os.clock()
    repeat
        espera(0.25)
    until Workspace.CurrentCamera or (os.clock() - t1) > 30
end

