    -- meuTime = "" aceita a primeira zona que contem o dono, que e' a
    -- propria regra dele ("MINHA primeira zona"). Preencher aqui
    -- ("attacker"/"defender") reativa a guarda por nome.
    meuTime = "",

    -- [A MARGEM DA ANCORA] o dono spawna na BORDA da caixa (medido: dentro
    -- por 0,5 stud em Z). Amostragem a cada 5 s + micro-ajuste de posicao
    -- = quando o modulo olha, ele pode estar 0,6 stud fora, e a ancora
    -- nunca crava. A ancora ACEITA a caixa expandida por este margem --
    -- so' para ANCORA (a posicao do dono no spawn): para os corpos a
    -- contencao continua EXATA (quem esta' na duvida fica pendente).
    margemAncora = 15,
}

-- ==========================================================================
--  UTILITARIOS
-- ==========================================================================
local TC_WORKSPACE = game:GetService("Workspace")

local EST = {
    zonas = nil,          -- lista de zonas
    aliada = nil,         -- booleano por zona
    origem = nil,         -- indice da zona que eu pisei primeiro
    ultimaVarredura = -math.huge,
    ultimaConsulta = -math.huge,
    nZonas = 0,
    nAliadas = 0,
    motivo = "iniciando",
    nVarreduras = 0,
    nClassificados = 0,
}

-- [MEMORIA POR NOME, NAO POR MODEL]
--
-- A regra diz "ate' o fim da partida". O `tracked` e' indexado por Model, e
-- o jogo CRIA UM MODEL NOVO quando o cara respawna -- entao memorizar por
-- Model perderia o veredito no respawn. O nome do corpo e' o que sobrevive
-- (medido: `15601021`, `7683325` aparecem em models diferentes ao longo do
-- tempo).
--
-- A memoria mora AQUI, dentro do modulo. Como o modulo e' compilado a cada
-- injecao, ela nasce limpa -- que e' o certo: partida nova, lados novos.
local MEMORIA = {}

local function tenta(fn)
    local ok, r = pcall(fn)
    if ok then return r end
    return nil
end

local function pontoXYZ(p)
    -- [VECTOR3 OU TABELA -- O CONSERTO DO ERRO `:135`]
    -- O coletor passa a posicao da raiz como Vector3 (rCache.Position); o
    -- modulo guarda zonas como {x,y,z}. `ponto[1]` num Vector3 estoura EM
    -- TODA CHAMADA -- medido: 24 080 erros em 45 s, o filtro falhando
    -- aberto, todo mundo desenhado. Aceitar os dois formatos e' o conserto.
    local t = type(p)
    if t == "table" then return p[1], p[2], p[3] end
    if t == "userdata" or t == "vector" then
        local ok, x, y, zw = pcall(function() return p.X, p.Y, p.Z end)
        if ok and x then return x, y, zw end
    end
    return nil
end

local function dentroDaCaixa(ponto, z)
    if not ponto or not z.pos or not z.tam then return false end
    local px, py, pz = pontoXYZ(ponto)
    if not px then return false end
    return math.abs(px - z.pos[1]) <= z.tam[1] * 0.5
       and math.abs(py - z.pos[2]) <= z.tam[2] * 0.5
       and math.abs(pz - z.pos[3]) <= z.tam[3] * 0.5
end

-- ==========================================================================
--  VARREDURA DAS ZONAS
-- ==========================================================================
-- [CALIBRADO PELA MEDICAO]
--
-- A primeira versao aceitava por palavra em qualquer nome e trouxe 105
-- "zonas" -- 95 eram cenario: `F1_SafetyLever`, `pulled`, `M67_SafetyPin`,
-- `Vending Machine`, `top_fin`. Nenhum deles e' zona.
--
-- O que restou de verdade vive sob uma pasta chamada `restricted`, com nomes
-- `attacker_ceasefire` / `defender_ceasefire`. Entao o criterio e':
--
--   * o CAMINHO contem `restricted` ou `ceasefire`   -> aceita
--   * o NOME contem `ceasefire` ou `restricted`      -> aceita
--   * o nome contem `boundary`                       -> RECUSA
--
-- `map boundary` existe no mapa e NAO e' zona de time: e' a parede. Se
-- entrasse, tudo que encosta na borda viraria "pisou em zona".
local PALAVRAS_CAMINHO = { "restricted", "ceasefire" }
local PALAVRAS_NOME = { "ceasefire", "restricted" }

local function temPalavra(txt, lista)
    -- [O ERRO #3 VEIO DAQUI]
    --
    -- `team_check_eixo:119: invalid argument #2 (string expected, got
    -- number)`. O `#2` e' o SEGUNDO argumento de `string.find` -- que aqui e'
    -- `p`, o elemento de `lista`. Se `lista` vier como uma TABELA NAO-ARRAY
    -- (ex.: `{restricted=true}`), `ipairs` nao itera e nada acontece; mas se
    -- ela vier com um numero dentro, `p` e' numero e o `string.find` estoura.
    --
    -- A guarda de `type(txt)` ja' existia. O que faltava era a guarda do
    -- OUTRO lado: `p`. Agora os dois lados sao checados, e a lista tambem --
    -- sem isso, um valor inesperado vira ERRO EM TODO ALVO, e um filtro que
    -- erra em todo alvo e' exatamente o "fica decorativo" que eu quero evitar.
    if type(txt) ~= "string" then return false end
    if type(lista) ~= "table" then return false end
    local low = string.lower(txt)
    for _, p in ipairs(lista) do
        if type(p) == "string" and string.find(low, p, 1, true) then
            return true
        end
    end
    return false
end

local function varreZonas()
    local saida = {}
    local vistos = 0

    local function aceita(inst, caminho)
        if vistos >= TC.tetoZonas then return end
        if not tenta(function() return inst:IsA("BasePart") end) then return end

        -- [O NOME PODE NAO SER STRING]
        --
        -- `inst.Name` num Instance e' sempre string, mas eu chamo isto
        -- tambem a partir de nos que vieram de `GetChildren()` no meio de
        -- uma arvore que o jogo pode estar destruindo. Um `Name` lido de um
        -- objeto ja' coletado pode voltar como outra coisa. A guarda e'
        -- barata e impede que UM objeto estranho derrube a varredura toda.
        local nome = inst.Name
        if type(nome) ~= "string" then return end
        if type(caminho) ~= "string" then caminho = tostring(caminho) end

        if string.find(string.lower(nome), "boundary", 1, true) then return end
        if not (temPalavra(caminho, PALAVRAS_CAMINHO)
                or temPalavra(nome, PALAVRAS_NOME)) then return end

        local p = tenta(function() return inst.Position end)
        local s = tenta(function() return inst.Size end)
        if not p or not s then return end
        vistos = vistos + 1

        saida[#saida + 1] = {
            nome = nome,
            pos = { p.X, p.Y, p.Z },
            tam = { s.X, s.Y, s.Z },
            idMod = tenta(function() return inst:GetAttribute("modfile_instance_id") end),
            caminho = caminho,
        }
    end

    local function desce(no, prof, prefixo)
        if prof > TC.profMax then return end
        if vistos >= TC.tetoZonas then return end
        for _, c in ipairs(tenta(function() return no:GetChildren() end) or {}) do
            local nome = tenta(function() return c.Name end) or "?"
            local caminho = prefixo .. "/" .. nome
            aceita(c, caminho)
            if tenta(function() return #c:GetChildren() > 0 end) then
                desce(c, prof + 1, caminho)
            end
        end
    end

    tenta(function() desce(TC_WORKSPACE, 0, "Workspace") end)
    return saida
end

-- ==========================================================================
--  A MINHA POSICAO
-- ==========================================================================
local function minhaPosicao()
    local pasta = tenta(function() return TC_WORKSPACE:FindFirstChild("characters") end)
    if pasta then
        local meu = tenta(function() return pasta:FindFirstChild(TC.meuCorpo) end)
        if meu then
            local raiz = tenta(function() return meu:FindFirstChild("humanoid_root_part") end)
            if not raiz then
                raiz = tenta(function() return meu:FindFirstChild("HumanoidRootPart") end)
            end
            if raiz then
                local p = tenta(function() return raiz.Position end)
                if p then
                    -- [DE ONDE VIEM O "eu"] vai para o dump: se a ancora
                    -- nunca formar, saber SE veio do corpo ou da CAMERA e'
                    -- metade do diagnostico (a camera de 3a pessoa pende
                    -- para tras e pode sair da caixa por 2 studs).
                    EST.fonteEu = "corpo:" .. tostring(TC.meuCorpo)
                    EST.meuPos = { p.X, p.Y, p.Z }
                    return EST.meuPos
                end
            end
        end
    end
    local cam = TC_WORKSPACE.CurrentCamera
    if cam then
        local cf = tenta(function() return cam.CFrame end)
        if cf then
            EST.fonteEu = "camera"
            EST.meuPos = { cf.Position.X, cf.Position.Y, cf.Position.Z }
            return EST.meuPos
        end
    end
    return nil
end

-- ==========================================================================
--  A CADEIA -- uniao por proximidade, em largura
-- ==========================================================================
local function montaCadeia(zonas, origem)
    local aliada = {}
    for i = 1, #zonas do aliada[i] = false end
    if not origem then return aliada, 0 end

    aliada[origem] = true
    local fila = { origem }
    local cabeca = 1
    local n = 1
    local r2 = TC.raioCadeia * TC.raioCadeia

    while cabeca <= #fila do
        local atual = fila[cabeca]; cabeca = cabeca + 1
        local pa = zonas[atual].pos
        for i = 1, #zonas do
            if not aliada[i] then
                local pb = zonas[i].pos
                local dx, dy, dz = pa[1] - pb[1], pa[2] - pb[2], pa[3] - pb[3]
                if dx * dx + dy * dy + dz * dz <= r2 then
                    aliada[i] = true
                    fila[#fila + 1] = i
                    n = n + 1
                end
            end
        end
    end
    return aliada, n
end

-- ==========================================================================
--  REMEDICAO
-- ==========================================================================
-- [A VARREdura NAO RODA POR ALVO]
--
-- `remedir` e' chamado de dentro de `veredito`, que o coletor chama POR ALVO
-- E POR QUADRO. A versao anterior fazia a varredura da arvore inteira do
-- Workspace dentro desse caminho -- dezenas de varreduras por segundo.
--
-- Pior: se a varredura estourasse, `EST.aliada` ficava `nil` e `veredito`
-- devolvia PENDENTE para TODO alvo -- ou seja, um erro virava "desenha o
-- mapa inteiro", e no quadro seguinte a varredura dava certo e escondia de
-- novo. ISSO E' O PISCAR.
--
-- Agora:
--   * a varredura tem o seu proprio relogio e roda no maximo a cada
--     `intervaloVarredura` segundos;
--   * um ERRO NA VARREDURA NAO APAGA A VARREDURA BOA ANTERIOR -- `EST.zonas`
--     so' e' substituido por um resultado valido e nao-vazio;
--   * se ainda nao ha' varredura boa nenhuma, o veredito e' PENDENTE (desenha)
--     -- mas isso e' um estado de CARREGAMENTO, e ele para assim que a
--     primeira varredura boa chega.
local function remedir()
    local agora = os.clock()
    local eu = minhaPosicao()

    if agora - EST.ultimaVarredura >= TC.intervaloVarredura then
        EST.ultimaVarredura = agora
        EST.nVarreduras = EST.nVarreduras + 1

        -- pcall de verdade em volta da varredura: um objeto estranho no meio
        -- da arvore nao pode zerar o estado.
        local ok, z = pcall(varreZonas)
        if ok and type(z) == "table" and #z > 0 then
            EST.zonas = z
            EST.nZonas = #z
            EST.erroVarredura = nil
            -- [A PARTICAO DEPENDE DAS ZONAS]
            -- Se a lista de zonas mudou (mapa terminou de carregar), a
            -- particao anterior foi calculada sobre outra lista: refaz.
            if EST.aliada and #EST.aliada ~= #z then
                EST.aliada = nil
            end
        else
            -- NAO apaga `EST.zonas`: a varredura boa anterior continua
            -- valendo. Sem isso, um erro momentaneo esconderia o mapa todo.
            EST.erroVarredura = tostring(z)
            EST.nVarreduraFalhas = (EST.nVarreduraFalhas or 0) + 1
        end
    end

    if not EST.zonas then
        EST.motivo = "sem zonas varridas"
        return
    end

    -- [A ORIGEM -- SO' A PRIMEIRA VEZ CONTA]
    if not EST.origem then
        if not eu then
            EST.motivo = "sem a minha posicao"
            return
        end
        local pisouErrado = nil
        local margem = tonumber(TC.margemAncora) or 0
        for i = 1, #EST.zonas do
            local z = EST.zonas[i]
            -- [A RECURRENCY DA ANCORA E' EXPANDIDA] dentroDaCaixa EXATA
            -- + margem por eixo. O dono na borda da propria zona conta.
            if z.pos and z.tam
               and math.abs(eu[1] - z.pos[1]) <= z.tam[1] * 0.5 + margem
               and math.abs(eu[2] - z.pos[2]) <= z.tam[2] * 0.5 + margem
               and math.abs(eu[3] - z.pos[3]) <= z.tam[3] * 0.5 + margem then
                local nomeZ = string.lower(tostring(z.nome or ""))
                if TC.meuTime ~= nil and TC.meuTime ~= "" then
                    -- [A GUARDA DO LADO] so' ativa com meuTime preenchido.
                    if string.find(nomeZ, string.lower(TC.meuTime), 1, true) then
                        EST.origem = i
                        break
                    else
                        pisouErrado = nomeZ
                    end
                else
                    EST.origem = i
                    break
                end
            end
        end
        if EST.origem then
            EST.motivo = "ancora: " .. tostring(EST.zonas[EST.origem].nome)
        elseif pisouErrado then
            EST.motivo = "no lado errado (" .. pisouErrado
                .. "; meuTime=" .. tostring(TC.meuTime) .. ")"
        else
            -- [O MOTIVO COM NUMEROS] "nao pisei" e vago quando eu ESTOU
            -- dentro de uma zona de verdade: as coordenadas do "eu" permitem
            -- comparar com as caixas no dump e ver QUANTO falta (ou se a
            -- zona onde estou nem esta' na lista das 10).
            EST.motivo = string.format("fora das %d zonas (eu=%.0f,%.0f,%.0f)",
                #EST.zonas, eu[1], eu[2], eu[3])
        end
        if not EST.origem then
            return
        end
    end

    if not EST.aliada then
        local ok, al, n = pcall(montaCadeia, EST.zonas, EST.origem)
        if ok and type(al) == "table" then
            EST.aliada = al
            EST.nAliadas = n or 0
            EST.motivo = "ok (ancora " .. tostring(EST.zonas[EST.origem].nome) .. ")"
        else
            EST.motivo = "cadeia falhou: " .. tostring(al)
        end
    end
end

-- ==========================================================================
--  O VEREDITO DE UM CORPO
-- ==========================================================================
-- `nome` e' o nome do corpo (estavel entre respawns).
-- `pos`  e' a posicao atual.
--
-- Devolve:
--     true   -> ALIADO    (nao desenha)
--     false  -> INIMIGO   (desenha)
--     nil    -> PENDENTE  (desenha -- ainda nao pisou em zona nenhuma)
local function veredito(nome, pos)
    if not TC.ligado then return nil end
    if type(nome) ~= "string" then return nil end

    -- [MEMORIA PRIMEIRO] ja' tem veredito: devolve e nao olha mais nada.
    --
    -- Isto e' o que impede o piscar: o veredito de um corpo e' calculado UMA
    -- vez e nunca mais recalculado. Nao ha' caminho pelo qual o mesmo corpo
    -- fique escondido num quadro e visivel no seguinte.
    local guardado = MEMORIA[nome]
    if guardado ~= nil then return guardado end

    -- [CACHE POR QUADRO]
    --
    -- `remedir` tem relogio proprio e nao faz trabalho caro mais de uma vez
    -- por `intervaloVarredura`, mas ele ainda e' chamado por alvo. Esta marca
    -- evita a chamada repetida dentro do mesmo quadro.
    local agora = os.clock()
    if agora - EST.ultimaConsulta > TC.intervaloVarredura then
        EST.ultimaConsulta = agora
        remedir()
    end

    if not EST.aliada or not EST.zonas then return nil end
    if not pos then return nil end

    -- Em que zona ele esta'? A primeira que contem o ponto E que tem lado.
    for i = 1, #EST.zonas do
        if dentroDaCaixa(pos, EST.zonas[i]) then
            local al = EST.aliada[i]
            if al ~= nil then
                -- [TRAVA] primeiro veredito. Nunca mais muda.
                MEMORIA[nome] = al
                EST.nClassificados = EST.nClassificados + 1
                return al
            end
        end
    end

    -- Nao esta' em zona nenhuma: PENDENTE. Desenha.
    return nil
end

-- ==========================================================================
--  O CONTRATO PARA O COLETOR
-- ==========================================================================
_G.TC = {
    -- nil = nao sei (desenha) | true = aliado (esconde) | false = inimigo
    veredito = veredito,

    -- para diagnostico, nunca para decidir
    estado = function()
        return {
            ligado = TC.ligado,
            nZonas = EST.nZonas,
            nAliadas = EST.nAliadas,
            nVarreduras = EST.nVarreduras,
            nVarreduraFalhas = EST.nVarreduraFalhas or 0,
            erroVarredura = EST.erroVarredura,
            nClassificados = EST.nClassificados,
            origem = EST.origem,
            motivo = EST.motivo,
            -- [A MINHA POSICAO E A FONTE DELA] para o dump vivo: de onde o
            -- modulo tirou o "eu" (corpo ou camera) e as coordenadas na hora
            -- da ultima consulta. E' o que decide se a ancora deveria ter
            -- formado.
            meuSrc = EST.fonteEu,
            meuPos = EST.meuPos,
            raioCadeia = TC.raioCadeia,
            nMemoria = (function()
                local n = 0
                for _ in pairs(MEMORIA) do n = n + 1 end
                return n
            end)(),
        }
    end,

    -- a lista de zonas, para a sonda
    zonas = function()
        local out = {}
        if not EST.zonas then return out end
        for i = 1, #EST.zonas do
            out[#out + 1] = {
                nome = EST.zonas[i].nome,
                pos = EST.zonas[i].pos,
                tam = EST.zonas[i].tam,
                idMod = EST.zonas[i].idMod,
                aliada = EST.aliada and EST.aliada[i] or nil,
            }
        end
        return out
    end,

    -- esquece o veredito de um nome (para eu testar)
    esquecer = function(nome) MEMORIA[nome] = nil end,

    -- todos os vereditos, para diagnostico
    memoria = function()
        local out = {}
        for nome, v in pairs(MEMORIA) do
            out[#out + 1] = { nome = nome, aliado = v }
        end
        return out
    end,

    config = TC,
    medirAgora = function() EST.ultimaVarredura = -math.huge; remedir() end,
}

return _G.TC

