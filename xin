        "Settings/" .. BRIDGE_STATE_FILE,
        BRIDGE_STATE_DIR .. "/" .. BRIDGE_STATE_FILE,
    }
    local ok, la = pcall(function()
        -- [POR QUE getgenv().LOCALAPPDATA E NAO OS.GETENV()]
        -- `os.getenv` NAO EXISTE no sandbox destes executores: a biblioteca
        -- `os` vem reduzida a clock/date/time/difftime. Chamar os.getenv
        -- levanta "attempt to call a nil value" DENTRO do pcall -- ou seja,
        -- seria engolido em silencio e o caminho absoluto nunca entraria na
        -- lista. O caminho relativo salva o caso comum; este e' o reforco.
        --
        -- `getgenv and ...` protege contra um executor que nao exponha
        -- getgenv: sem a guarda, indexar nil levantaria, e o pcall
        -- transformaria isso em "sem caminho absoluto" sem avisar.
        return getgenv and getgenv().LOCALAPPDATA
    end)
    if ok and type(la) == "string" and la ~= "" then
        table.insert(list, la .. "/" .. BRIDGE_STATE_DIR .. "/" .. BRIDGE_STATE_FILE)
        table.insert(list, la .. "/Xeno/workspace/" .. BRIDGE_STATE_FILE)
        table.insert(list, la .. "/Matrix/workspace/" .. BRIDGE_STATE_FILE)
    end

