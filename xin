-- =====================================================================
local function normalizeTeam(v)
    local t = typeof(v)
    if t == "Instance" or t == "BrickColor" then return v.Name end
    if t == "Color3" then return v:ToHex() end
    if t == "string" or t == "number" then return tostring(v) end
    return nil
end

local function addKey(keys, v)
    local s = normalizeTeam(v)
    if s and s ~= "" then keys[string.lower(s)] = true end
end

local function collectKeys(obj, keys)
    if not obj then return end
    for _, field in ipairs(CONFIG.TEAM_FIELDS) do
        local okA, attr = pcall(function() return obj:GetAttribute(field) end)
        if okA and attr ~= nil then addKey(keys, attr) end
        local child = obj:FindFirstChild(field)
        if child and child:IsA("ValueBase") then
            local okV, val = pcall(function() return child.Value end)
            if okV then addKey(keys, val) end
        end
    end
end

-- [ORDEM] Estas tabelas e a funcao de atualizacao sao DECLARADAS AQUI,
-- antes de getEntityKeys/getMyKeys que as leem. Em Lua um `local` nao
-- existe antes da sua linha: declarar depois fazia aquelas funcoes lerem
-- um GLOBAL nil, e `LEADERBOARD[uid]` levantava "attempt to index nil" a
-- cada quadro -- o coletor pararia em silencio, sem desenhar nada.
local LEADERBOARD, FEED_TAGS = {}, {}
local leaderboardAt, feedAt = 0, 0
-- [DESEMPENHO] Assinatura dos nomes do placar/feed. Comparar esta string
-- substitui o guiTag por objeto (0,14 ms) no caminho quente do TEAM_CACHE.
local leaderboardSig, feedSig = nil, nil
-- [MEDIDO] Estes TTL eram 0,5 s. No jogo medido, UM scan custava 254,70 ms
-- (PlayerGui com 116.423 descendentes; GetDescendants() 52 ms + o filtro
-- string.match 203 ms + guiTag 304 ms). A 2 scans/s isso e' 509 ms/s da
-- thread principal -- mais de METADE de todo o tempo, e 15 quadros de uma
-- vez (o orcamento de um quadro a 60 fps e' 16,7 ms). Era essa a causa do
-- travamento, e nao o overlay.
--
-- 3 s e' folgado: a cor de um jogador num placar nao muda a cada meio
-- segundo, e o overlay ja' reage na hora pelo Team/atributo quando existe.
local LEADERBOARD_TTL = 3.0
local FEED_TTL = 3.0

-- [DESEMPENHO] Containers onde um placar/killfeed realmente mora. Varrer o
-- PlayerGui INTEIRO (116 mil objetos) para achar ~2200 e' desperdicio: a UI
-- principal do jogo (Main + Hud = 113.584 dos 116.423) nao tem placar.
-- A busca por nome exato e' O(1) via FindFirstChild, entao a lista nao custa.
local SOCIAL_ROOTS = {
    "ReactUI", "Leaderboard", "LeaderboardContainer", "Scoreboard",
    "ScoreBoard", "Score", "PlayerList", "Killfeed", "KillFeed", "KillfeedUI",
}
-- Atribuida adiante, depois que os scanners forem definidos.
local refreshSocialCaches

-- Chaves de time de um modelo. O overlay recebe a LISTA CRUA e decide a
-- relacao (aliado/inimigo) comparando com as chaves do jogador local.
-- Manter a decisao no overlay e' o ponto: o Lua nao julga mais nada.
local function getEntityKeys(model, owner)
    local cached = TEAM_CACHE[model]
    local now = os.clock()
    if cached and now - cached.at < CONFIG.TEAM_REFRESH then return cached.keys end
    local keys = {}
    if owner then
        pcall(function()
            if owner.Team then
                addKey(keys, owner.Team.Name)
                if owner.Team.TeamColor then addKey(keys, owner.Team.TeamColor.Name) end
            end
            if not owner.Neutral and owner.TeamColor then addKey(keys, owner.TeamColor.Name) end
        end)
        collectKeys(owner, keys)
    end
    collectKeys(model, keys)
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then collectKeys(hum, keys) end
    -- Placar e killfeed: fontes que o Team/atributo nao cobre. O placar
    -- casa pelo UserId; o feed casa pelo nome exibido.
    if owner then
        local doPlacar = LEADERBOARD[owner.UserId]
        if doPlacar then addKey(keys, doPlacar) end
        local doFeed = FEED_TAGS[owner.Name]
            or FEED_TAGS[owner.DisplayName]
        if doFeed then addKey(keys, doFeed) end
    end
    local doFeedModel = FEED_TAGS[model.Name]
    if doFeedModel then addKey(keys, doFeedModel) end
    TEAM_CACHE[model] = {keys = keys, at = now}
    return keys
end

local function getMyKeys()
    local keys = {}
    pcall(function()
        if player.Team then
            addKey(keys, player.Team.Name)
            if player.Team.TeamColor then addKey(keys, player.Team.TeamColor.Name) end
        end
        if not player.Neutral and player.TeamColor then addKey(keys, player.TeamColor.Name) end
    end)
    collectKeys(player, keys)
    -- A cor do proprio jogador tambem pode vir do placar/feed.
    local doPlacar = LEADERBOARD[player.UserId]
    if doPlacar then addKey(keys, doPlacar) end
    local doFeed = FEED_TAGS[player.Name] or FEED_TAGS[player.DisplayName]
    if doFeed then addKey(keys, doFeed) end
    local char = player.Character
    if char then
        collectKeys(char, keys)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then collectKeys(hum, keys) end
    end
    return keys
end

-- Lista serializavel para o overlay (arrays, nao sets).
-- [DESEMPENHO] O comparador era uma closure criada A CADA chamada (criar
-- funcao em Lua aloca + fecha upvalue). Agora mora no escopo do modulo.
local function cmpStr(a, b) return a < b end

local function keysToArray(keys)
    local out = {}
    for k in pairs(keys) do out[#out + 1] = k end
    table.sort(out, cmpStr)
    return out
end

-- =====================================================================
-- 5. VIDA / DONO
-- =====================================================================
local function healthOf(model)
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        return tonumber(hum.Health), tonumber(hum.MaxHealth), hum.Health <= 0
    end
    local h = tonumber(model:GetAttribute("Health"))
    local mh = tonumber(model:GetAttribute("MaxHealth"))
    local dead = model:GetAttribute("Dead") == true
        or model:GetAttribute("IsDead") == true
        or model:GetAttribute("Alive") == false
    return h, mh, dead
end

-- [SEM HUMANOID -- NAO DA' PARA DIZER "MORTO"]
--
-- Medido: zero Humanoid em 1044 Models e zero atributo Health. A versao
-- anterior terminava em `return h ~= nil and h > 0`, que com h == nil dava
-- FALSE -- "sem informacao" virava "morto", e nenhum corpo entrava.
--
-- Sem sinal de vida, mantenho VIVO. E' a mesma regra do estadoVida logo
-- abaixo: nao apagar um alvo legitimo por falta de API do executor.
-- [RAIZES QUE SO' EXISTEM COM O CORPO EM PE']
--
-- Ordem: `humanoid_root_part` primeiro. Medido neste jogo, o corpo vivo tem
-- essa parte em y~2.7-3.9; o cadaver perde ela e o `hitbox`, sobra so' o
-- `torso` no chao (y~0.3). Usado pelo isAlive para separar vivo de morto.
--
-- Precisa estar ANTES do isAlive: um `local` em Lua so' existe a partir da
-- propria declaracao. (Este projeto ja' tropecou nisso tres vezes -- wsEnvia,
-- tcEstado e agora aqui.)
-- [RAIZES QUE SO' EXISTEM COM O CORPO EM PE']
--
-- SO' `humanoid_root_part`. Nada mais. Duas versoes erradas antes desta:
--
--   v1: incluia `head`/`Head`  -> TODO cadaver tem `head`, filtro decorativo
--   v2: incluia `hitbox`       -> TODA ARMA tem `hitbox` (o prepared_weapon
--                                tem 1 parte, e e' o hitbox), e a arma
--                                passava como corpo vivo. 7 de 9 alvos eram
--                                arma na medicao.
--
-- Medido no pacote, os tres tipos lado a lado:
--
--   VIVO  7683325         8 partes, humanoid_root_part y=3.85, hitbox y=3.58
--   MORTO 15670803        6 partes, SEM humanoid_root_part, SEM hitbox
--   ARMA  prepared_weapon 1 parte,  SEM humanoid_root_part, COM hitbox
--
-- O `humanoid_root_part` e' o UNICO discriminante: existe no corpo vivo, nao
-- existe no cadaver, nao existe na arma. `hitbox` e `head` existem em dois
-- dos tres tipos cada -- por isso nao servem de criterio.
local RAIZES_EM_PE = { "humanoid_root_part", "HumanoidRootPart" }

-- =====================================================================
-- VIDA -- UMA FONTE SO'
-- =====================================================================
--
-- [POR QUE VIROU UMA FUNCAO SO']
--
-- Existiam DUAS logicas de vida, e elas divergiam:
--
--   isAlive(model)     -> bool     usada no REGISTRO (registerModel)
--   estadoVida(m)      -> 0/1/3    usada POR PACOTE (listaViva)
--
-- A primeira pergunta "tem raiz de pe'?" e responde sim/nao. A segunda
-- devolvia um TRISTATE, e o tristate era consumido assim:
--
--     if est ~= 0 then vivos[#vivos+1] = ... end
--
-- Ou seja: `3` (desconhecido) contava como VIVO. E `3` era justamente o que
-- saia quando o corpo NAO tinha a raiz procurada -- porque o teste era
--
--     if leu and not achou then return 0 end
--     return 3
--
-- e `leu` so' virava true se a busca DEVOLVESSE algo. Cadaver nao devolve
-- nada, entao `leu=false`, o `if` nao disparava, e o cadaver voltava como
-- `3` = vivo. O filtro so' matava corpo que TIVESSE a raiz que define a
-- vida -- exatamente o contrario do pretendido.
--
-- Agora ha' UMA funcao, que devolve um veredito explicito de tres estados:
--
--     VIVO    -- raiz de pe' presente (ou atributo/Health dizendo que vive)
--     MORTO   -- leitura OK e a raiz NAO esta' la'
--     SEM_LER -- a leitura FALHOU (pcall, API ausente): nao julgo
--
-- A distincao entre MORTO e SEM_LER e' o ponto: "ausencia confirmada" nao e'
-- a mesma coisa que "nao consegui olhar". O codigo antigo colapsava as duas.
local VIVO, MORTO, SEM_LER = 1, 0, 3

local function estadoVida(m)
    -- Fonte 1: Health de Humanoid. So' existe em jogos com rig padrao.
    local hum = m:FindFirstChildOfClass("Humanoid")
    if hum then
        local ok, h = pcall(function() return tonumber(hum.Health) end)
        if ok and h ~= nil then
            if h <= 0 then return MORTO end
            return VIVO
        end
    end

    -- Fonte 2: atributos explicitos de morte. Sao a palavra do servidor e
    -- tem prioridade sobre qualquer inferencia geometrica.
    local okA, vivoAttr = pcall(function()
        if m:GetAttribute("Alive") == false then return false end
        if m:GetAttribute("Dead") == true then return false end
        if m:GetAttribute("IsDead") == true then return false end
        local h = tonumber(m:GetAttribute("Health"))
        if h ~= nil then return h > 0 end
        return nil
    end)
    if okA and vivoAttr == false then return MORTO end
    if okA and vivoAttr == true then return VIVO end

    -- Fonte 3: o rig. Este jogo nao tem Humanoid, nem Health, nem TeamColor
    -- -- medido --, entao e' aqui que a decisao acontece de fato.
    --
    -- Medido no pacote, os tres tipos lado a lado:
    --
    --   VIVO  7683325         8 partes, humanoid_root_part y=3.85
    --   MORTO 15670803        6 partes, SEM humanoid_root_part, altura 0.15
    --   ARMA  prepared_weapon  1 parte, SEM humanoid_root_part
    --
    -- O `humanoid_root_part` e' o unico discriminante: `head` existe no
    -- cadaver tambem, `hitbox` existe na arma tambem. Tentar usar qualquer um
    -- dos dois ja' produziu filtro decorativo neste projeto.
    --
    -- O pcall separa os dois casos que o codigo antigo confundia:
    --   okBusca=false         -> SEM_LER (a busca levantou: nao julgo)
    --   okBusca=true, false   -> MORTO    (olhei, e nao esta' la')
    --   okBusca=true, true    -> VIVO
    local okBusca, achou = pcall(function()
        for _, nome in ipairs(RAIZES_EM_PE) do
            local p = m:FindFirstChild(nome, true)
            if p ~= nil and p:IsA("BasePart") then return true end
        end
        return false
    end)
    if not okBusca then return SEM_LER end
    if achou then return VIVO end
    return MORTO
end

-- O registro usa a MESMA funcao. Nao ha' mais duas logicas para divergir:
-- "consegui olhar e nao ha' raiz" reprova o registro na hora.
local function isAlive(model)
    return estadoVida(model) ~= MORTO
end

local function resolveOwner(model)
    local byChar = Players:GetPlayerFromCharacter(model)
    if byChar then return byChar end
    local uid = tonumber(model:GetAttribute("PresentationOwnerUserId"))
    if uid then
        local p = Players:GetPlayerByUserId(uid)
        if p then return p end
    end
    if model:GetAttribute("CharacterType") == "PlayerCustomCharacter" then
        return Players:FindFirstChild(model.Name)
    end
    return nil
end

-- =====================================================================
-- 5b. PLACAR E KILLFEED  (fontes de time que o Team/atributo nao cobre)
-- =====================================================================
-- Alguns jogos nao usam Player.Team nem atributos: pintam o placar e o
-- feed de abates. Estes dois leitores extraem a cor de cada jogador dali.
--
-- O Lua NAO decide quem e' aliado. Ele so' le a cor e manda a etiqueta
-- ("red"/"blue"); comparar com a cor do jogador local e' trabalho do
-- overlay, que e' quem faz o team check.
--
-- Tudo aqui e' pcall: essas GUIs mudam de nome entre jogos e nao podem
-- derrubar o coletor.
local TEAM_TAGS = {
    red = "red", blue = "blue", vermelho = "red", azul = "blue",
    ["time vermelho"] = "red", ["time azul"] = "blue",
}
-- Tolerancia de cor: as cores do Roblox raramente batem exato. O script
-- original usava +-13/255; aqui 0.06 (15/255) e' proximo e mais tolerante
-- a antialias de texto.
local COR_TOL = 0.06
local COR_RED = {1.0, 0.235, 0.235}    -- ~ Color3.fromRGB(255,60,60)
local COR_BLUE = {0.0, 0.470, 1.0}     -- ~ Color3.fromRGB(0,120,255)

-- Propriedades de cor que um placar pode pintar. Tabela no escopo do modulo
-- para o guiTag nao recriar a lista a cada chamada (era uma tabela literal
-- dentro do pcall, alocada 2208 vezes por scan).
local COR_PROPS = {"BackgroundColor3", "TextColor3", "ImageColor3", "BorderColor3"}

local function tagFromColor(c)
    if typeof(c) ~= "Color3" then return nil end
    local rd, gd, bd = math.abs(c.R - COR_RED[1]), math.abs(c.G - COR_RED[2]),
                       math.abs(c.B - COR_RED[3])
    if rd <= COR_TOL and gd <= COR_TOL and bd <= COR_TOL then return "red" end
    local rb, gb, bb = math.abs(c.R - COR_BLUE[1]), math.abs(c.G - COR_BLUE[2]),
                       math.abs(c.B - COR_BLUE[3])
    if rb <= COR_TOL and gb <= COR_TOL and bb <= COR_TOL then return "blue" end
    return nil
end

local function tagFromName(s)
    if type(s) ~= "string" then return nil end
    local low = string.lower(s)
    for chave, tag in pairs(TEAM_TAGS) do
        if string.find(low, chave, 1, true) then return tag end
    end
    return nil
end

-- Cor de GUI de um objeto: olha cor de fundo, de texto e de contorno,
-- porque o placar pode pintar qualquer um dos tres.
--
-- [MEDIDO] Este pcall externo custava 304 ms nos 2208 objetos que casavam
-- (0,14 ms cada). O pcall nao era o problema -- o problema era ele existir
-- sobre um laco de 4 consultas de propriedade. A funcao continua protegida,
-- mas o custo real agora e' so' o das propriedades que existem: uma UICorner
-- ou um UIStroke nao tem BackgroundColor3, e ler propriedade inexistente
-- num Instance de GUI nao lanca no Roblox (devolve nil), entao o pcall
-- interno por propriedade foi trocado por typeof, que ja' filtra.
local function guiTag(obj)
    -- Sem pcall: acessar propriedade inexistente devolve nil, e typeof(nil)
    -- nao e' "Color3". O pcall so' mascarava isso ao custo de 0,14 ms cada.
    for _, prop in ipairs(COR_PROPS) do
        local c = obj[prop]
        if typeof(c) == "Color3" then
            local t = tagFromColor(c)
            if t then return t end
        end
    end
    -- Fallback: o NOME do objeto costuma carregar a cor (ex: "Red_12345").
    local t2 = tagFromName(obj.Name)
    if t2 then return t2 end
    -- Ultimo recurso: o TEXTO mostrado. So' objetos com .Text tem texto.
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        local t3 = tagFromName(obj.Text)
        if t3 then return t3 end
    end
    return nil
end

-- Placar: procura recipientes de jogadores e casa pelo UserId no nome.
-- O script original lia ReactUI.LeaderboardContainer...Red_<UserId>.
-- Aqui a busca e' por PADRAO (procura <Tag>_<numero> em qualquer nivel),
-- porque o caminho exato muda de jogo para jogo.
--
-- [DESEMPENHO] Duas mudancas que tiram 254 ms de dentro do quadro:
--
--   1. NAO varre mais o PlayerGui inteiro. Procura primeiro os containers
--      conhecidos (SOCIAL_ROOTS) e so' cai no PlayerGui completo se nenhum
--      existir. No jogo medido isso evita 113.584 objetos por scan.
--
--   2. O filtro de nome deixou de ser um string.match ancorado por objeto.
--      `^(%a+)_(%d+)$` compila o padrao e faz backtracking em CADA um dos
--      116 mil nomes -- sozinho custava 203 ms, 4x a propria travessia.
--      Agora: find de "_" (barato, sem padrao) elimina a esmagadora maioria,
--      e so' o resto paga o match. O resultado e' identico: mesmo Tag, mesmo
--      id, mesma tabela LEADERBOARD[userId].
local function achaRoots()
    local roots = {}
    local playerGui = player:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return roots, nil end
    for _, nome in ipairs(SOCIAL_ROOTS) do
        local r = playerGui:FindFirstChild(nome, true)
        if r then roots[#roots + 1] = r end
    end
    return roots, playerGui
end

-- [DEVOLVE TAMBEM A ASSINATURA] Alem do placar, esta funcao devolve uma
-- string que muda quando QUALQUER cos candidato muda. E' o que permite ao
-- getEntityKeys (laco quente) parar de chamar tagFromName e guiTag a cada
-- TEAM_REFRESH: ele compara a string, que e' O(1) com interning do Lua.
--
-- Detalhe que faz o custo cair muito: a assinatura sai SO' DOS NOMES (e dos
-- filhos TextLabel/TextButton), NUNCA das 4 consultas de cor. guiTag custava
-- 0,14 ms por objeto; num placar de 2200 objetos isso eram 308 ms por
-- varredura -- pior que a travessia inteira. Como a estrututa e os nomes sao
-- exatamente o que entra e sai de um placar, o nome basta como sinal.
local function scanLeaderboard()
    local out = {}
    local roots, playerGui = achaRoots()
    -- Sem container conhecido: mantem o comportamento antigo (varredura
    -- total), porque e' melhor custar caro do que nao achar o placar.
    local fontes = #roots > 0 and roots or (playerGui and {playerGui} or nil)
    if not fontes then return out, nil end

    local sig = {}
    -- [DIAGNOSTICO DO PLACAR]
    --
    -- Conta o que a varredura achou, para eu saber se o placar existe e com
    -- que convencao de nome ele trabalha. Sem isto, "LEADERBOARD vazio" tem
    -- duas causas indistinguiveis: nao achei o placar, ou achei e nao soube
    -- ler a etiqueta. Grava no disco, nunca no console do jogo.
    local nMacharam, nComEtiqueta, exemplos = 0, 0, {}
    for _, fonte in ipairs(fontes) do
        pcall(function()
            local lista = fonte:GetDescendants()
            for i = 1, #lista do
                local obj = lista[i]
                local nm = obj.Name
                -- Pre-filtro barato: sem "_" nao pode casar Tag_Numero.
                if string.find(nm, "_", 1, true) then
                    local tag, id = string.match(nm, "^(%a+)_(%d+)$")
                    -- [O PADRAO PEGA LIXO DE UI -- MEDIDO NO JOGO]
                    --
                    -- `^(%a+)_(%d+)$` casa qualquer Palavra_Numero. Medido
                    -- neste jogo, os 11 "acertos" foram:
                    --
                    --     bar_0, bar_1, bar_2, preload_0..3, ral_8000
                    --
                    -- Sao nomes de UI (barra, tela de carregamento), nao de
                    -- jogador. O placar daqui NAO usa Tag_UserId no nome do
                    -- objeto -- essa era a convencao do jogo de onde este
                    -- coletor veio.
                    --
                    -- Sem um UserId de verdade, uma etiqueta de cor seria
                    -- atribuida a "bar_0" e o overlay cruzaria com um jogador
                    -- que nao existe. Pior que nao ter o dado.
                    --
                    -- Agora exijo que o numero pareca um UserId do Roblox
                    -- (>= 6 digitos). `bar_0` e `ral_8000` caem fora. Isso e'
                    -- um filtro de sanidade, nao uma prova -- se o placar
                    -- deste jogo realmente usar outro esquema, os exemplos em
                    -- coletor_placar.txt vao mostrar.
                    if tag and #id >= 6 then
                        local uid = tonumber(id)
                        if uid then
                            nMacharam = nMacharam + 1
                            if #exemplos < 12 then
                                exemplos[#exemplos + 1] = nm
                            end
                            -- Assinatura: o NOME carrega a cor (Tag_Numero) e
                            -- o valor de Text* carrega o resto. Nenhuma
                            -- consulta de cor, nenhum guiTag.
                            sig[#sig + 1] = nm
                            local txt = nil
                            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                                txt = obj.Text
                            end
                            sig[#sig + 1] = txt or ""

                            -- [O `out` NUNCA RECEBIA NADA -- PLACAR MORTO]
                            --
                            -- Esta funcao achava `Tag_<UserId>` em qualquer
                            -- nivel, validava o numero... e DESCARTAVA o uid.
                            -- `out` era criado vazio, alimentado por ninguem,
                            -- e devolvido vazio em todo scan. O chamador fazia
                            -- `LEADERBOARD = novoLb` com uma tabela vazia.
                            --
                            -- Consequencia em cadeia: `LEADERBOARD[owner.UserId]`
                            -- (getEntityKeys) sempre nil -> o `addKey` da cor do
                            -- placar nunca executava -> o unico sinal de time
                            -- que nao depende de geometria estava morto. Todo o
                            -- custo da varredura era pago, e o resultado jogado
                            -- fora.
                            --
                            -- Agora grava o que o placar oferece: a ETIQUETA de
                            -- cor que esta' no proprio nome do objeto. E' a mesma
                            -- convencao que o guiTag ja' usa (`tagFromName`), e o
                            -- overlay e' quem compara com a cor do jogador local.
                            local etiqueta = tagFromName(tag)
                            if etiqueta then
                                nComEtiqueta = nComEtiqueta + 1
                                local antigo = out[uid]
                                if antigo == nil then
                                    out[uid] = etiqueta
                                else
                                    -- Mesmo uid em duas cores: guarda as duas,
                                    -- separadas por "|". Nao escolho por conta
                                    -- propria -- se as duas fontes divergem, o
                                    -- dado sai e quem decide e' o overlay.
                                    if not string.find(antigo, etiqueta, 1, true) then
                                        out[uid] = antigo .. "|" .. etiqueta
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    -- [GRAVA O QUE O PLACAR REALMENTE TEM]
    --
    -- Duas causas indistinguiveis sem isto: "o placar nao existe" e "existe,
    -- mas os nomes nao seguem a convencao Tag_UserId que eu procuro". Os
    -- exemplos de nome resolvem a duvida de uma vez.
    if type(writefile) == "function" then
        local linhas = {
            "pastas varridas: " .. tostring(#fontes),
            "nomes Tag_UserId encontrados: " .. nMacharam,
            "com etiqueta reconhecida: " .. nComEtiqueta,
            "entradas gravadas: " .. tostring(#out),
            "exemplos de nome:",
        }
        for i = 1, #exemplos do
            linhas[#linhas + 1] = "  " .. exemplos[i]
        end
        pcall(writefile, "coletor_placar.txt",
            table.concat(linhas, "\n") .. "\n")
    end

    return out, table.concat(sig, "\1")
end

-- Killfeed: ultimo abate visto define a cor do abatedor. Guarda o alvo
-- como INIMIGO de quem matou -- o overlay cruza isso com as chaves.
-- Formato tipico: PlayerGui.ReactUI.KillfeedUI.<n>.Content.{Killer,Victim}
local function scanFeed()
    local out = {}
    local playerGui = player:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return out, nil end
    local sig = {}
    pcall(function()
        -- [DESEMPENHO] DOIS FindFirstChild em cascata custavam DOIS
        -- GetChildren() (4,3 ms cada) para escolher o mesmo container. Aqui
        -- a lista e' buscada UMA vez e a escolha e' feita na tabela.
        local react = playerGui:FindFirstChild("ReactUI")
        if not react then return end
        local kids = react:GetChildren()
        local feed = nil
        for i = 1, #kids do
            local nm = kids[i].Name
            if nm == "KillfeedUI" or nm == "KillFeedUI" or nm == "Killfeed" then
                feed = kids[i]
                break
            end
        end
        if not feed then return end
        for _, entry in ipairs(feed:GetChildren()) do
            local content = entry:FindFirstChild("Content") or entry
            local killer = content:FindFirstChild("Killer")
                or content:FindFirstChild("KillerName")
            local victim = content:FindFirstChild("Victim")
                or content:FindFirstChild("VictimName")
            if killer and victim then
                -- A cor do texto diz o time de cada um.
                local tk = guiTag(killer)
                local tv = guiTag(victim)
                local nk = killer:IsA("TextLabel") and killer.Text or killer.Name
                local nv = victim:IsA("TextLabel") and victim.Text or victim.Name
                if nk and tk then out[nk] = tk end
                if nv and tv then out[nv] = tv end
                sig[#sig + 1] = tostring(nk) .. "\1" .. tostring(tk)
                sig[#sig + 1] = tostring(nv) .. "\1" .. tostring(tv)
            end
        end
    end)
    return out, table.concat(sig, "\2")
end

-- Cache: varrer PlayerGui inteiro custa caro. 3 s e' frequente o bastante
-- para um placar e barato o bastante para nao pesar.
-- Atribui na variavel ja' declarada (sem `local`), para nao criar uma
-- segunda variavel que as funcoes de time nao enxergariam.
--
-- [CACHE DE PACOTE] Esta funcao virou tambem o UNICO lugar que invalida o
-- cache de quadro inteiro. Motivo: o pacote so' depende da posicao das
-- partes, da camera e das etiquetas de time. Posicao e camera o laco
-- principal ja' ve' sozinho. As etiquetas de time vem de atributos
-- (GETTER_INVALIDA_PACOTE) ou DAQUI. Descobrir que uma cor de placar mudou
-- exige comparar assinatura, e a assinatura so' pode ser lida quando o TTL
-- vence -- entao e' aqui que se detecta e se forca UM reenvio.
--
-- O getEntityKeys NAO precisa mais comparar assinatura (era uma copia de
-- string por scan): ele so' le as tabelas, e quem as mantem frescas e'
-- esta funcao, que ja' roda a cada quadro.
refreshSocialCaches = function()
    local now = os.clock()
    if now - leaderboardAt >= LEADERBOARD_TTL then
        leaderboardAt = now
        local novoLb, sigLb = scanLeaderboard()
        if sigLb ~= leaderboardSig then
            leaderboardSig = sigLb
            bridgeLastSig = nil      -- o placar mudou: um envio e' obrigatorio
        end
        LEADERBOARD = novoLb
    end
    if now - feedAt >= FEED_TTL then
        feedAt = now
        local novoFeed, sigFeed = scanFeed()
        if sigFeed ~= feedSig then
            feedSig = sigFeed
            bridgeLastSig = nil
        end
        FEED_TAGS = novoFeed
    end
end

-- =====================================================================
-- 6. RASTREAMENTO DE MODELOS
-- =====================================================================
local function refreshParts(data)
    local model = data.model
    data.parts = {}
    for _, name in ipairs(CONFIG.PART_NAMES) do
        -- [BUG CORRIGIDO -- O SEGUNDO ARGUMENTO FALTAVA]
        --
        -- Era `model:FindFirstChild(name)`, que so' procura entre os filhos
        -- DIRETOS. Medido no jogo, com um NPC e um jogador lado a lado:
        --
        --   NPC (givemeyoursoul, R6):
        --     filhos diretos: Humanoid, Collider (Model), HumanoidRootPart,
        --                     <guid> (Model)
        --     FindFirstChild(name)      -> 1 parte  (so' o HumanoidRootPart)
        --     FindFirstChild(name,true) -> 16 partes
        --
        --   Jogador (DinosaurTerror1, R15):
        --     filhos diretos: as 16 partes + Humanoid + scripts
        --     FindFirstChild(name)      -> 16 partes
        --
        -- O corpo do NPC mora DENTRO de sub-modelos ("Collider" e um modelo
        -- com nome GUID), nunca como filho direto. Entao o NPC entrava no
        -- pacote com UMA parte -- o tronco de 2x2x1 -- e a caixa 2D saia com
        -- ~12x11 px (ou era descartada pelo corte de 2 px em
        -- caixa_do_alvo). O esqueleto saia com 0 linhas, porque os pares de
        -- CONFIG.SKELETON nao encontravam as duas pontas.
        --
        -- Efeito visivel: os jogadores tinham ESP completo e os NPCs
        -- praticamente nada -- o que parecia "ESP nao funciona" quando a
        -- maioria dos alvos da partida era NPC.
        --
        -- O `true` faz a busca ser recursiva. O custo e' irrelevante: isto
        -- roda UMA vez por modelo rastreado (registerModel e refreshParts),
        -- nao por quadro -- o buildTarget depois le de data.parts.
        local part = model:FindFirstChild(name, true)
        if part and part:IsA("BasePart") then data.parts[name] = part end
    end
    -- [DESEMPENHO/BUG REAL] data.slots era declarado em registerModel e
    -- NUNCA preenchido. O cache de partes do buildTarget comparava com nil,
    -- entao "acertava" pela metade do corpo: as partes do vetor PART_NAMES
    -- (16 nomes) ficavam sem slot e eram lidas CRUAS a cada quadro -- e
    -- eram justamente as unicas que apareciam. So' as partes de R6
    -- ("Left Arm" e companhia) tinham slot.
    --
    -- [BUG CORRIGIDO -- SLOT NASCIA SEM TAMANHO = partes=0 NO PACOTE]
    -- Aqui os dois lados passam a existir. MAS esta versao antiga criava o
    -- slot como {part = part, cf = nil} -- e o buildTarget (que reconstruiu
    -- o cache) so' recria o slot quando `sl.part ~= part`. Com o slot
    -- pre-existente tendo part == part, a reconstrucao era pulada, e a
    -- lista p lida sl.sx/sy/sz = NIL. `{nil, nil, nil}` em Lua e' uma
    -- tabela VAZIA (# == 0), entao TODA parte saia com tamanho vazio, o
    -- servidor descartava cada uma, e o /pacote entregava alvos com
    -- partes=0 -- com as linhas do esqueleto intactas (elas so' usam nomes
    -- de data.parts, nao os slots). Medido pela sonda: data.parts=16,
    -- data.slots=16, buildTarget devolve nP=16 com `item s=0`.
    --
    -- O conserto: o slot creado aqui ja' nasce COM o tamanho, no MESMO
    -- formato que o buildTarget mantem. Tamanho e' imutavel por parte, entao
    -- ler uma vez aqui e' correto -- posicao/rotacao continuam frescas por
    -- pacote (ver o bloco do buildTarget).
    data.slots = {}
    for name, part in pairs(data.parts) do
        local sz = part.Size
        data.slots[name] = {part = part,
                            sx = sz.X, sy = sz.Y, sz = sz.Z}
    end
end

-- [NOMES DE RAIZ -- ESTE JOGO NAO USA R6 NEM R15]
