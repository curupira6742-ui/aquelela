    -- hz: teto de envios por segundo, 0 = sem teto.
    quant   = false,
    sig     = false,
    bin     = false,   -- transporte binario; ver montaBinario e otim_bin.py
    ws      = false,   -- conexao persistente; ver wsEnvia e ws_server.py
