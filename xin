local MLockC = 0      -- quantos corpos travados

local function achaMarcadores(agora)
    -- [REVALIDACAO BARATA] se a GUI morreu (rematch), o Parent some
    if MGui then
        local vivo = false
        pcall(function()
            vivo = MGui.sg and MGui.sg.Parent and MGui.sg.Enabled and true or false
        end)
        if vivo and (agora - MGuiEm) < 3 then return MGui end
        MGui = nil
    else
        if (agora - MGuiEm) < 3 then return nil end
    end
    MGuiEm = agora
    if not Players then return nil end
    local ok, pg = pcall(function()
        local pl = Players.LocalPlayer
        return pl and pl:FindFirstChild("PlayerGui") or nil
    end)
    if not ok or not pg then return nil end
    -- [O TESTE DEFINITIVO] a GUI certa tem 4+ frames com TAMBEM o texto
    -- do label IGUAL ao nome do frame (medido nos 8: nome==nick). O painel
    -- de fps e o tutorial tem no maximo 2 e texto diferente do nome.
    local melhorN = 0
    local melhorSg = nil
    local melhorMarcos = nil
    pcall(function()
        for _, sg in ipairs(pg:GetChildren()) do
            if sg:IsA("ScreenGui") and sg.Enabled then
                local marcos, n = {}, 0
                for _, d in ipairs(sg:GetDescendants()) do
                    if d:IsA("Frame") then
                        local quad, nick = false, false
                        pcall(function()
                            for _, sub in ipairs(d:GetChildren()) do
                                if sub:IsA("Frame") then
                                    local s = sub.Size
                                    if s.X.Offset >= 2 and s.X.Offset <= 20
                                       and s.Y.Offset >= 2 and s.Y.Offset <= 20 then
                                        quad = true
                                    end
                                elseif sub:IsA("TextLabel") then
                                    if #sub.Text > 0
                                       and tostring(sub.Text) == tostring(d.Name) then
                                        nick = true
                                    end
                                end
                            end
                        end)
                        if quad and nick then
                            n = n + 1
                            marcos[n] = d
                        end
                    end
                end
                if n > melhorN then
                    melhorN = n
                    melhorSg = sg
                    melhorMarcos = marcos
                end
            end
        end
    end)
    if melhorSg and melhorN >= 4 then
        MGui = { sg = melhorSg, marcos = melhorMarcos }
        return MGui
    end
    return nil
end

local function leMarcadores(agora)
    -- o lote e fresco? (0,5 s e a GUI dos marcadores nao e' barata de varrer
    -- com GetDescendants -- o teste e' so' nos 8 frames guardados)
    if MLote and (agora - MLoteEm) < 0.5 then return MLote end
    MLoteEm = agora
    local gui = achaMarcadores(agora)
    if not gui then
        MLote = nil
        return nil
    end
    local lote, n = {}, 0
    -- o inset da barra de titulo: AbsolutePosition mora no espaco DE GUI,
    -- WorldToViewportPoint no espaco DO VIEWPORT. Com IgnoreGuiInset=false
    -- (padrao) a GUI comeca DEPOIS do topo -- somar o inset pra casar.
    local insetX, insetY = 0, 0
    pcall(function()
        local gs = game:GetService("GuiService")
        local inset = gs and gs:GetGuiInset()
        if inset then
            insetX = math.floor(inset.X + .5)
            insetY = math.floor(inset.Y + .5)
        end
    end)
    local ignoraInset = false
    pcall(function() ignoraInset = gui.sg.IgnoreGuiInset end)
    if ignoraInset then insetX, insetY = 0, 0 end
    pcall(function()
        for _, m in ipairs(gui.marcos) do
            local vis = false
            pcall(function() vis = m.Visible end)
            if vis then
                local nick = tostring(m.Name)
                pcall(function()
                    for _, sub in ipairs(m:GetChildren()) do
                        if sub:IsA("TextLabel") and #sub.Text > 0 then
                            nick = tostring(sub.Text)
                            break
                        end
                    end
                end)
                local aX, aY = nil, nil
                pcall(function()
                    local ap = m.AbsolutePosition
                    local as = m.AbsoluteSize
                    aX = ap.X + as.X * 0.5
                    aY = ap.Y + as.Y * 0.5
                end)
                if aX then
                    n = n + 1
                    lote[n] = {
                        nick = nick,
                        x = math.floor(aX - insetX + .5),
                        y = math.floor(aY - insetY + .5),
                    }
                end
            end
        end
    end)
    MLote = lote
    return MLote
end

-- [O CASAMENTO] centro projetado da raiz do corpo x centro do quadradinho.
-- Devolve o NICK do aliado OU nil. roda TODO pacote (sem cache de leitura):
-- a confirmacao de 2 pacotes seguidos precisa de casamentos reais, nao do
-- eco do anterior. O MCorpo so' alimenta o DISPLAY (TTL 3 s).
local function casaNick(modelNome, raiz, camera, agora)
    if not raiz or not camera then return nil end
    local lote = leMarcadores(agora)
    if not lote or #lote == 0 then return nil end
    local posR = raiz.Position
    local okP, res = pcall(function()
        return camera:WorldToViewportPoint(
            Vector3.new(posR.X, posR.Y, posR.Z))
    end)
    if not okP or not res then return nil end
    -- [XENO] o WorldToViewportPoint devolve S O Vector3 (sem onScreen):
    -- o pcall acima colapsa multi-retorno no PRIMEIRO valor, que  o
    -- Vector3 -- e o caso Roblox-padro tambm vem como Vector3 aqui.
    if type(res) ~= "table" or not res.X then return nil end
    local vx, vy, vz = res.X, res.Y, res.Z
    if not vx or not vy then return nil end
    if vz and vz <= 0 then return nil end -- atras da camera: nenhum marker
    local melhorNick, melhorD = nil, nil
    for _, m in ipairs(lote) do
        if m.x and m.y then
            local dx = m.x - vx
            -- o nick fica 14px ABAIXO do quadradinho: o centro do CORPO na
            -- tela cai entre os dois; janela vertical folgada (100 px)
            local dy = m.y - vy
            if math.abs(dx) <= 70 and math.abs(dy) <= 100 then
                local d2 = dx * dx + dy * dy
                if not melhorD or d2 < melhorD then
                    melhorD = d2
                    melhorNick = m.nick
                end
            end
        end
    end
    if melhorNick then
        MCorpo[modelNome] = { nick = melhorNick, em = agora }
        MCont = MCont + 1
        return melhorNick
    end
    return nil
end

-- =====================================================================
-- [O CODINOME DOS INIMIGOS -- UM NICK DO PLACAR, PINADO POR CORPO]
--
-- Pedido do dono (palavras dele): "tendo acesso ao placar atribua de
-- forma aleatoria 1 dos nicks pra um dos userid que cada esp tem e
-- envie pro overlay" -- e o refinamento: "apenas os inimigos".
--
-- Os aliados NAO pegam codinome: ja' tem o nick real pelo quadradinho.
-- Para os corpos que o quadradinho nunca confirmou (inimigos e
-- pendentes), o nome vira um nick do PLACAR REAL do jogo (a ScreenGui
-- {1814FF63} que lista os 15: "ANTO | K/D | PTS | COMPLEX ... SYNO ...").
--
-- O POOL e' filtrado: exclui MEU nome, exclui os nicks ja' TRAVADOS
-- como aliados (MALIADOS_NICK) e exclui os codinomes ja' PINADOS em
-- outros corpos. Sobra, na pratica, exatamente o roster do time
-- inimigo: 6 corpos, 6 nicks, sem repetir.
--
-- O pin e' ESTAVEL: o mesmo corpo fica com o mesmo nick ate o fim da
-- partida (a regra de 1 vez do dono, so' que pro codinome). Se um nick
-- pinoado depois for confirmado como ALIADO pelo quadradinho, o pin
-- dele e' SOLTO (na linha do MLockN no filtro) e o corpo re-pin no
-- proximo pacote com o pool corrigido.
-- =====================================================================
local PlacarGui = nil       -- a ScreenGui do placar (achada pelo teste)
local PlacarEm = 0          -- ultima leitura (rate 5 s)
local PlacarNicks = nil     -- lista de nicks de jogador no placar
local MPIN = {}             -- [nomeCorpo] = nick codinome (estavel)
math.randomseed(os.time())

local function lerPlacar(agora)
    if PlacarNicks and (agora - PlacarEm) < 5 then return PlacarNicks end
    PlacarEm = agora
    if not Players then return nil end
    local ok, pg = pcall(function()
        local pl = Players.LocalPlayer
        return pl and pl:FindFirstChild("PlayerGui") or nil
    end)
    if not ok or not pg then return nil end
    -- [REVALIDACAO] a GUI pode ser recriada (rematch): se o pai sumiu,
    -- refaz a busca inteira
    local guiVivo = false
    if PlacarGui then
        pcall(function()
            guiVivo = PlacarGui.Parent and PlacarGui.Enabled and true or false
        end)
    end
    if not guiVivo then
        -- [O TESTE] o ScreenGui com MAIS TextLabels cujo texto e' nome de
        -- Player: os cabecalhos ("COMPLEX", "KING OF THE HILL") e colunas
        -- ("K/D", "PTS") nao passam porque nao sao Players.
        local melhorN, melhorSg = 0, nil
        pcall(function()
            for _, sg in ipairs(pg:GetChildren()) do
                if sg:IsA("ScreenGui") and sg.Enabled then
                    local n = 0
                    for _, d in ipairs(sg:GetDescendants()) do
                        if d:IsA("TextLabel") and #d.Text >= 3 and #d.Text <= 24 then
                            if Players:FindFirstChild(tostring(d.Text)) then
                                n = n + 1
                            end
                        end
                    end
                    if n > melhorN then
                        melhorN = n
                        melhorSg = sg
                    end
                end
            end
        end)
        if melhorSg and melhorN >= 4 then
            PlacarGui = melhorSg
        else
            PlacarGui = nil
            PlacarNicks = nil
            return nil
        end
    end
    local nicks, nN = {}, 0
    pcall(function()
        for _, d in ipairs(PlacarGui:GetDescendants()) do
            if d:IsA("TextLabel") and #d.Text >= 3 and #d.Text <= 24 then
                local txt = tostring(d.Text)
                if Players:FindFirstChild(txt) then
                    nN = nN + 1
                    nicks[nN] = txt
                    if nN >= 30 then break end
                end
            end
        end
    end)
    PlacarNicks = nicks
    return nicks
end

local function pinInimigo(nomeCorpo, agora)
    local pin = MPIN[nomeCorpo]
    if pin then return pin end
    -- [O POOL AO VIVO] placar - meu nome - aliados travados - ja' pinados
    local meuNome = nil
    pcall(function()
        local pl = Players.LocalPlayer
        if pl then meuNome = tostring(pl.Name) end
    end)
    local nicks = lerPlacar(agora)
    if not nicks or #nicks == 0 then return nil end
    local usados = {}
    for _, nick in pairs(MPIN) do usados[nick] = true end
    local pool, n = {}, 0
    for _, nick in ipairs(nicks) do
        if nick ~= meuNome and not MALIADOS_NICK[nick] and not usados[nick] then
            n = n + 1
            pool[n] = nick
        end
    end
    if n == 0 then return nil end
    local escolhido = pool[math.random(1, n)]
    MPIN[nomeCorpo] = escolhido
    return escolhido
end

local function buildTarget(v, slot, agoraPacote)
    local model = v.model
    local parts = v.data.parts
    local slots = v.data.slots
    local gen = v.data.gen
    local sig = {}
    local nP = 0
    local nS = 0
    -- Declarada FORA do `if`: com CONFIG.sendParts desligado o alvo ainda e'
    -- montado (nome, vida, time), so' sem geometria -- e a linha do `t` la'
    -- embaixo precisa de uma tabela, nao de nil.
    local listaPartes = {}
    local posPorNome = {}
    -- [DIAGNOSE DO PACOTE] coleta do ciclo, ver bloco pos-laco:
    local diagSeg = ""
    local diagComS, diagSemS = 0, 0
    local diagAtivo = (agoraPacote - diagEm) >= 2

    if CONFIG.sendParts then
        -- [BUG CORRIGIDO: escrevia na tabela que estava iterando]
        --
        -- Antes:
        --      for name, part in pairs(parts) do
        --          ...
        --          parts[nP] = { n = name, ... }   -- nP e' NUMERICO
        --      end
        --      ...
        --      parts = parts                      -- devolvia a MESMA tabela
        --
        -- Dois defeitos num:
        --
        --   1. `parts` e' `v.data.parts`, a tabela NOMEADA e COMPARTILHADA
        --      que o registerModel monta (name -> Instance). O laco iterava
        --      por nome e escrevia em chaves numericas NA MESMA TABELA,
        --      corrompendo-a no meio da propria iteracao. Como a tabela
        --      sobrevive ao quadro, o segundo quadro ja' encontrava lixo.
        --
        --   2. Devolver `parts` (linha do `t = {...}`) entregava essa tabela
        --      corrompida ao JSONEncode, em vez da lista de partes prontas.
        --
        -- Efeito medido: `tracked` subia, `listaViva` devolvia os alvos
        -- vivos, `buildTarget` nao levantava erro, a assinatura saia com
        -- ~25000 caracteres -- e `pkt.targets` saia VAZIO. O servidor
        -- respondia 204 e o overlay nao desenhava nada.
        --
        -- Agora a saida vai para `listaPartes`, uma tabela nova por chamada.
        for name, part in pairs(parts) do
            -- [HITBOX FORA DA CAIXA -- O CONSERTO DA CAIXA GRANDE]
            -- Medido no pacote: hitbox = 6.0x7.71x4.92 (maior que o corpo:
            -- cabeca 1x1x1, torso 2x2x1, bracos 0.85x2x0.85). A caixa do
            -- overlay e' a UNIAO de todas as partes -- com o hitbox ela
            -- vira 6x7.7 e chega a dobrar o visual de perto. A caixa certa
            -- e' a do CORPO: as partes vis, que sao as unicas RENDERIZADAS
            -- pelo jogo. O hitbox nao alimenta caixa, esqueleto nem mira.
            if name == "hitbox" then continue end
            -- [BUG CORRIGIDO -- SEGUNDA METADE DO MESMO DEFEITO]
            --
            -- Era `if part.Parent == model then`, que exige a parte como filho
            -- DIRETO. O refreshParts passou a achar as partes por busca
            -- recursiva, entao data.parts ficou CORRETO (16 entradas em NPC)
            -- -- e este filtro descartava 15 delas na hora de montar o pacote,
            -- deixando so' o HumanoidRootPart. O sintoma era identico ao de
            -- antes do fix: caixa de ~12x11 px e esqueleto com 0 linhas.
            --
            -- Confirmado no jogo (Wrath, NPC R6):
            --   filhos diretos do modelo = 4
            --   data.parts               = 16 entradas
            --   partes no pacote         = 1
            --   arvore real: Collider/Head,
            --               <guid>/UpperTorso, <guid>/LowerTorso, ...
            --
            -- A intencao original era "a parte ainda pertence a este modelo?"
            -- (uma parte reciclada poderia ter sido reparentada para outro
            -- personagem). `IsDescendantOf` responde exatamente isso, e
            -- continua barato: roda uma vez por parte por modelo rastreado,
            -- nao por quadro.
            -- ["partes"] O teste entra ANTES do IsDescendantOf para a parte
            -- descartada nao custar nem uma leitura de propriedade: e' o que
            -- faz esta opcao economizar CPU, e nao so' bytes.
            if (not OTIM.partes or PARTES_CAIXA[name]) and part:IsDescendantOf(model) then
                local sl = slots[name]
                if not sl or sl.part ~= part then
                    -- [CORRECAO] O slot agora cachea SO' o que nao muda:
                    -- a Instance e o tamanho (imutavel por parte). Posicao e
                    -- rotacao NUNCA mais sao cacheadas -- sao lidas TODO
                    -- pacote, logo abaixo.
                    sl = { part = part,
                           sx = part.Size.X, sy = part.Size.Y, sz = part.Size.Z }
                    slots[name] = sl
                end

                local cf = part.CFrame
                local p = cf.Position
                local xa, ya, za = cf.XVector, cf.YVector, cf.ZVector
                -- ["quant"] Posicao a 1/8 de stud. O JSONEncode escreve o
                -- float inteiro: "-13.047382354736" sao 16 bytes, "-13.125"
                -- sao 7. 12,5 cm e' menos que a espessura da linha da caixa
                -- na tela, entao o desenho nao muda.
                local px, py, pz = p.X, p.Y, p.Z
                if OTIM.quant then
                    px = (px*8//1)/8; py = (py*8//1)/8; pz = (pz*8//1)/8
                end
                nP = nP + 1
                local item
                if OTIM.delta then
                    -- [ABA CONFIG -- OTIMIZACAO "delta"]
                    -- Formato compacto: a parte vira {i=<indice>, p=...}.
                    -- O indice substitui o nome de qualquer forma (economia
                    -- da otimizacao "indice" vem de graca aqui), e o overlay
                    -- reconstroi a lista a partir dele.
                    item = { i = PART_INDEX[name] or 0, p = {px, py, pz} }
                    if precisaTamanho(sl, agoraPacote) then
                        item.s = {sl.sx, sl.sy, sl.sz}
                    end
                else
                    item = {
                        -- [ABA CONFIG -- OTIMIZACAO "indice"]
                        -- O nome ia repetido 9x no pacote ("HumanoidRootPart"
                        -- 9 vezes = 171 bytes so' de um nome). O indice
                        -- numerico usa a ordem de CONFIG.PART_NAMES -- ver
                        -- PARTES_POR_INDICE em ponte_servidor.py.
                        n = OTIM.indice and (PART_INDEX[name] or 0) or name,
                        p = {px, py, pz},
                    }
                    -- [OTIMIZACAO 2] O tamanho e' IMUTAVEL e o slot ja' o
                    -- cacheia; ia em todo pacote (~20 B x 46 partes = ~920 B
                    -- de pura repeticao). Agora vai na primeira vez e a cada
                    -- REENVIO_S, para um overlay que subiu depois nao ficar
                    -- sem tamanho nenhum.
                    if precisaTamanho(sl, agoraPacote) then
                        item.s = {sl.sx, sl.sy, sl.sz}
                    end
                end
                -- [ABA CONFIG -- OTIMIZACAO "rotacao"]
                -- Sem `r`: o overlay projeta os 8 cantos do AABB e desenha
                -- uma caixa ALINHADA A' TELA. Ele nunca le a rotacao -- o
                -- campo existia so' porque o formato nasceu assim.
                --
                -- E' 89,2% do pacote (medido: 14.149 de 15.867 bytes).
                --
                -- A ASSINATURA CONTINUA LENDO A ROTACAO (logo abaixo): e' ela
                -- que detecta que um alvo se mexeu, e o custo de montar a
                -- string e' local, nao vai para a rede. Sem isso, andar em
                -- linha reta sem girar sumiria de novo.
                if not OTIM.rotacao then
                    item.r = {{xa.X, xa.Y, xa.Z}, {ya.X, ya.Y, ya.Z},
                              {za.X, za.Y, za.Z}}
                end
                listaPartes[nP] = item
                posPorNome[name] = item.p
                if item.s ~= nil then
                    diagComS = diagComS + 1
                else
                    diagSemS = diagSemS + 1
                end
                if diagAtivo and #diagSeg < 180 then
                    diagSeg = diagSeg .. name .. "="
                        .. string.format("%gx%gx%g ", sl.sx, sl.sy, sl.sz)
                end
                -- [BUG CORRIGIDO -- CAIXA CONGELADA ATE' A MORTE]
                --
                -- A versao anterior lia `part.CFrame` UMA vez, quando o slot
                -- nascia, e guardava px/py/pz (+ matriz de rotacao) para
                -- sempre. O slot so' era recriado quando a Instance mudava ou
                -- `gen` incrementava -- e as unicas coisas que incrementam gen
                -- sao os binds de ChildAdded/ChildRemoved (linhas ~1015-1027),
                -- ou seja: MORTE/RESPAWN. Sintoma exato, relatado pelo
                -- usuario: "as caixas so' sao geradas quando morrem, nao na
                -- localizacao exata dos alvos". NPC estatico parecia certo
                -- por sorte (nao anda); jogador em movimento ficava preso no
                -- lugar onde foi visto pela primeira vez.
                --
                -- Custo medido do conserto: 1 leitura de CFrame por parte por
                -- pacote -- 16 partes x ~10 alvos x 60 pacotes/s = ~9.600
                -- leituras/s, na casa de 1-2% de um nucleo. Contra uma caixa
                -- que nao segue ninguem, e' o preco certo.
                -- [ABA CONFIG] A leitura de CFrame e a montagem de `item`
                -- agora acontecem DENTRO do if de "incluir" (acima). Aqui
                -- so' resta a ASSINATURA, que roda sempre -- inclusive para
                -- partes que a otimizacao "partes" descartou do envio. Ela
                -- e' local e nao vai para a rede; mante-la intacta e' o que
                -- garante que um alvo que se mexe nunca seja classificado
                -- como "repetido" pelo sendBridge.
                -- [BUG CORRIGIDO -- A ASSINATURA IGNORAVA A POSICAO]
                --
                -- Era so' a rotacao, com o argumento de que "se a parte se
                -- move, a rotacao acompanha". FALSO: andar em linha reta
                -- TRANSLA sem girar nenhum grau -- a assinatura ficava
                -- identica, o sendBridge (via bridgeLastSig) classificava o
                -- pacote como "igual ao anterior" e o descartava, RECRIANDO
                -- o mesmo sintoma de caixa congelada por outro caminho.
                --
                -- Agora: posicao arredondada a 0,1 stud (~10 cm; passos de
                -- caminhada movem 0,26 stud por pacote a 16 studs/s, entao
                -- movimento real sempre aparece) e rotacao a 2 casas
                -- (0,01 rad ??? 0,6 grau, invisivel no desenho). Um alvo
                -- PARADO continua sendo descartado como repetido; um que
                -- se mexe um centimetro relevante, nao.
                -- [DESPERDICIO REMOVIDO -- O CFRAME ERA LIDO DUAS VEZES]
                -- Aqui havia um segundo `part.CFrame` com mais quatro leituras
                -- de propriedade (Position, XVector, YVector, ZVector) para
                -- montar a assinatura -- exatamente os mesmos valores que as
                -- linhas acima acabaram de ler em cf/p/xa/ya/za. Eram 5
                -- property-gets a mais por parte por pacote: com 46 partes a
                -- 60 pacotes/s, ~13.800 leituras/s jogadas fora. Agora reusa.
                nS = nS + 1
                if OTIM.sig then
                    -- ["sig"] Assinatura so' por POSICAO, em inteiro de 1/4 de
                    -- stud: 3 numeros no lugar de 12 floats formatados. A
                    -- rotacao nao precisa entrar -- o overlay desenha caixa
                    -- alinhada a tela e nunca le rotacao, entao girar sem
                    -- andar nao muda um pixel. O `//` evita string.format,
                    -- que era o custo real deste bloco.
                    sig[nS] = (p.X*4//1) .. "," .. (p.Y*4//1) .. "," .. (p.Z*4//1)
                else
                    sig[nS] = string.format("%.1f,%.1f,%.1f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f",
                        p.X, p.Y, p.Z,
                        xa.X, xa.Y, xa.Z, ya.X, ya.Y, ya.Z, za.X, za.Y, za.Z)
                end
            end
        end
    end

    -- [ALIASES DE MIRA] clones CamelCase com a posicao da parte real e
    -- tamanho ~0. A caixa (uniao dos cantos) nao muda; ossos_do_alvo passa
    -- a ter 'Head' etc; escolhe_alvo (overlay.py:1049) acorda. Precisa o
    -- 'r': o servidor v2 exige a matriz por parte (vs_secure_server:828).
    local mIdent = {{1,0,0},{0,1,0},{0,0,1}}
    for alias, src in pairs(ALIASES_OSSO) do
        local pSrc = posPorNome[src]
        if pSrc then
            nP = nP + 1
            listaPartes[nP] = { n = alias, p = pSrc,
                                s = {0.05, 0.05, 0.05}, r = mIdent }
        end
    end

    -- [A FOTOGRAFIA -- 1 por 2 s] medidas do jogo sobre o rig: tamanho real
    -- de cada parte, GetExtentsSize (a bounding do proprio jogo), texto de
    -- nametag (o nick que o jogo mostra!), kind/display/chaves de time.
    if diagAtivo then
        diagEm = agoraPacote
        local extents = pcall(function()
            local cfE, sE = model:GetBoundingBox()
            return sE.X .. "x" .. sE.Y .. "x" .. sE.Z
                .. " c=" .. string.format("%.0f,%.0f,%.0f", cfE.Position.X, cfE.Position.Y, cfE.Position.Z)
        end)
        local extTxt = extents and select(2, pcall(function()
            local cfE, sE = model:GetBoundingBox()
            return sE.X .. "x" .. sE.Y .. "x" .. sE.Z
                .. " c=" .. string.format("%.0f,%.0f,%.0f", cfE.Position.X, cfE.Position.Y, cfE.Position.Z)
        end)) or "sem_bbox"

        -- [O NICK SOBRE A CABECA] BillboardGui/SurfaceGui com TextLabel:
        -- o jogo DESNEHA o nick; o texto e' a fonte honesta de display.
        local nGui, tagTxt = 0, ""
        pcall(function()
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
                    nGui = nGui + 1
                    if tagTxt == "" then
                        for _, e in ipairs(d:GetDescendants()) do
                            if e:IsA("TextLabel") and e.Text ~= nil
                               and tostring(e.Text) ~= "" then
                                tagTxt = tostring(e.Text)
                                break
                            end
                        end
                    end
                end
            end
        end)

        local otTxt = ""
        pcall(function()
            otTxt = "d" .. tostring(OTIM.delta and 1 or 0)
                .. "i" .. tostring(OTIM.indice and 1 or 0)
                .. "r" .. tostring(OTIM.rotacao and 1 or 0)
                .. "p" .. tostring(OTIM.partes and 1 or 0)
                .. "s" .. tostring(OTIM.sig and 1 or 0)
        end)

        diagUltimo = table.concat({
            "m=" .. tostring(model.Name),
            "kind=" .. tostring(v.data.owner and "player" or "npc"),
            "dep=" .. tostring(v.display),
            "tK=" .. tostring(v.team and #v.team or -1),
            "nP=" .. tostring(nP),
            "sOK=" .. tostring(diagComS) .. "/" .. tostring(diagSemS),
            "ext=" .. tostring(extTxt),
            "gui=" .. tostring(nGui),
            "tag=" .. (tagTxt ~= "" and tagTxt or "-"),
            "ot=" .. otTxt,
            "pt=" .. diagSeg,
        }, " ")
    end

    local lines = {}
    local nL = 0
    if CONFIG.sendSkeleton then
        for _, pair in ipairs(CONFIG.SKELETON) do
            local a, b = parts[pair[1]], parts[pair[2]]
            -- Mesmo defeito do laco de partes acima: `a.Parent == model`
            -- exigia filho direto, e no NPC as partes moram em sub-modelos.
            -- Resultado medido: 14 pares validos no jogador, 0 no NPC.
            if a and b and a:IsDescendantOf(model) and b:IsDescendantOf(model) then
                -- Nomes, nao coordenadas: o overlay projeta e desenha.
                nL = nL + 1
                lines[nL] = {pair[1], pair[2]}
            end
        end
    end

    -- UM FindFirstChildOfClass e UMA leitura de vida por alvo por quadro.
    -- Antes: healthOf chamava de novo o mesmo FindFirstChildOfClass e o
    -- isAlive do laco chamava um TERCEIRO. Eram 3 varreduras dos filhos
    -- para responder a mesma pergunta.
    local hum = model:FindFirstChildOfClass("Humanoid")
    local health, maxHealth, dead
    if hum then
        health = tonumber(hum.Health)
        maxHealth = tonumber(hum.MaxHealth)
        dead = health ~= nil and health <= 0
    else
        local h = tonumber(model:GetAttribute("Health"))
        local mh = tonumber(model:GetAttribute("MaxHealth"))
        health, maxHealth = h, mh
        dead = model:GetAttribute("Dead") == true
            or model:GetAttribute("IsDead") == true
            or model:GetAttribute("Alive") == false
    end

    -- [BUG: `data` NAO EXISTE NESTE ESCOPO]
    --
    -- O parametro desta funcao e' `v`, e o dono do alvo mora em `v.data`
    -- -- como as tres linhas do topo (1137-1139) ja' fazem corretamente.
    -- Aqui estava `data.owner`, um nome que nao e' visivel de dentro do
    -- `buildTarget`: as unicas `data` do arquivo sao locais de outras
    -- funcoes (registerModel:942, removeModel:990) e variaveis de laco
    -- (1020, 1323), nenhuma delas alcancavel daqui.
    --
    -- Efeito medido: `attempt to index nil with 'owner'` em TODOS os alvos,
    -- a cada quadro. Como a linha 1423 envolve esta chamada num `pcall`, o
    -- erro era engolido em silencio -- `targets` ficava vazio para sempre,
    -- o overlay nao recebia um unico alvo, e nada indicava o porque.
    -- O contador `tracked` subia normalmente (9 alvos), o `listaViva`
    -- tambem (9 vivos), e so' o pacote saia zerado.
    local owner = v.data.owner
    local t = {
        -- Identificacao
        model = model.Name,
        kind = owner and "player" or "npc",
        display = owner and owner.Name or model.Name,
        -- Vida
        hp = health,
        maxHp = maxHealth,
        dead = dead and true or false,
        -- Time: lista CRUA de chaves. O overlay compara com as do jogador
        -- local e decide aliado/inimigo/desconhecido.
        team = CONFIG.sendTeam and keysToArray(getEntityKeys(model, owner)) or nil,
        -- A lista EMPILHADA de partes (nome, pos, tamanho, rotacao 3x3).
        -- `listaPartes` e' local desta chamada: `v.data.parts` continua sendo
        -- o mapa nomeado que o registerModel mantem, intocado.
        parts = listaPartes,
        lines = lines,
    }
    if hum then
        local dn = hum.DisplayName
        if type(dn) == "string" and dn ~= "" then t.display = dn end
    end
    return t, sig, nP
end

-- =====================================================================
-- 8b. ASSINATURA DO PACOTE (portao que evita o POST e o JSONEncode)
-- =====================================================================
-- Mesma ORDEM de insercao (pairs sobre `tracked`) e conteudo derivado
-- apenas de valores que a propria assinatura cobre: assim que nada muda de
-- verdade, o JSON que sairia e' identico e a assinatura tambem.
local MAX_SIG_PARTS = 18

-- ---------------------------------------------------------------------
-- Compatibilidade de executor e vida do PROPRIO corpo
-- ---------------------------------------------------------------------
-- Estas duas funcoes separam "o Roblox nao tem esta API" (problema de
-- executor) de "a API existe e devolveu isto" (problema de dado). Sem isso
-- um executor que nao tenha GetPartsObsolete devolveria nil calado.
local OBSOLETO_FN = nil
local OBSOLETO_TIPO = "nao verificada"
local partsParaLimpar = nil

local function descartarObsoletas()
    if type(OBSOLETO_FN) == "function" and partsParaLimpar then
        pcall(OBSOLETO_FN, partsParaLimpar)
    end
    partsParaLimpar = nil
end

local function safeLower(which)
    local fn = Workspace.GetPartsObsolete
    if type(fn) ~= "function" then
        OBSOLETO_TIPO = "indisponivel"
        return 0, 0
    end
    OBSOLETO_FN = fn
    local ox, oy
    if which == "left" then
        local a, b = pcall(fn, Workspace, "left")
        ox, oy = tonumber(a), tonumber(b)
    else
        local a, b = pcall(fn, Workspace, "top")
        ox, oy = tonumber(a), tonumber(b)
    end
    if type(ox) == "number" and type(oy) == "number" then
        OBSOLETO_TIPO = "ok"
        return ox, oy
    end
    OBSOLETO_TIPO = "erro de leitura"
    return 0, 0
end

-- Vidas dos alvos SOB O PONTO DE VISTA DO ENVIO. A lista `tracked` e'
-- PREGUICOSA de proposito: o laco principal nao pode gastar
-- FindFirstChildOfClass em cada modelo do mundo a cada quadro. Entao um
-- alvo so' entra na lista quando, no comeco do quadro, JA' esta' vivo; e a
-- unica transicao que importa -- vivo -> morto -- e' detectada comparando o
-- MESMO sinal de vida que o pacote usa (hum.Health).
--
-- O defeito que isto corrige: o `isAlive(model)` do laco antigo so' rodava
-- no ramo FALSO do if, ou seja, NUNCA num modelo com Parent. Um corpo que
-- morresse com o Model ainda no Workspace (o caso normal) continuava
-- entrando no pacote para sempre, com hp=0: o overlay seguia desenhando o
-- cadaver e, pior, o pacote nunca ficava identico -- o hp ia de 100 a 0.
local vivos = {}
local rascunho = {}

-- Quantos corpos o filtro de morte ja' tirou do `tracked`. Diagnostico:
-- aparece no /health do servidor, para eu saber se o filtro esta' agindo sem
-- precisar de sonda nova.
tcMortosRemovidos = 0


local function listaViva(agora)
    table.clear(vivos)
    for model, data in pairs(tracked) do
        if not model.Parent then
            removeModel(model)
            alvoVida[model] = nil
        else
            local est = estadoVida(model)
            alvoVida[model] = est

            -- [MORTO SAI DO `tracked` NA HORA, NAO SO' DO PACOTE]
            --
            -- Antes: `if est ~= 0 then ... end` -- o morto deixava de ser
            -- listado, mas FICAVA no `tracked` com as partes congeladas, o
            -- veredito de time memorizado e as conexoes vivas. Voltava a
            -- aparecer a qualquer reavaliacao, e segurava memoria de um
            -- corpo que nao existe mais.
            --
            -- Medido no pacote: cada nome aparecia 2-3x, vivo e morto, com
            -- models diferentes. O jogo recicla nome, entao o `tracked`
            -- acumulava cada encarnacao.
            --
            -- Remove apenas em MORTO (0) CONFIRMADO. SEM_LER (3) fica: nao
            -- se julga o que nao se conseguiu olhar.
            if est == 0 then
                removeModel(model)
                alvoVida[model] = nil
                tcMortosRemovidos = tcMortosRemovidos + 1
            else
                vivos[#vivos + 1] = {model = model, data = data}
            end
        end
    end
    if #vivos > CONFIG.MAX_TARGETS then
        -- Um corpo morto no fim da lista e' justamente o que se quer
        -- empurrar para fora do pacote.
        table.sort(vivos, function(a, b)
            return alvoVida[a.model] > alvoVida[b.model]
        end)
        for i = #vivos, CONFIG.MAX_TARGETS + 1, -1 do vivos[i] = nil end
    end
    agora = agora or os.clock()
    for i = 1, #vivos do
        local v = vivos[i]
        v.deadNow = alvoVida[v.model] == 0
        v.health, v.maxHealth = nil, nil
        local hum = v.model:FindFirstChildOfClass("Humanoid")
        if hum then
            v.health = tonumber(hum.Health)
            v.maxHealth = tonumber(hum.MaxHealth)
        else
            v.health = tonumber(v.model:GetAttribute("Health"))
            v.maxHealth = tonumber(v.model:GetAttribute("MaxHealth"))
        end
        v.modelName = v.model.Name
        v.hum = hum
        local owner = v.data.owner
        v.display = owner and owner.Name or v.model.Name
        if hum then
            local dn = hum.DisplayName
            if type(dn) == "string" and dn ~= "" then v.display = dn end
        end
        -- Chaves de time: vem do cache do getEntityKeys (sem copia), e o
        -- keysToArray so' refaz o array quando as chaves sao OUTRO objeto.
        -- Chave de time nao muda enquanto o mesmo cache viver.
        if CONFIG.sendTeam then
            local k = getEntityKeys(v.model, owner)
            if v.keys ~= k then
                v.keys = k
                v.team = keysToArray(k)
            end
        else
            v.team = nil
        end
    end
    return agora
end

-- ["tela"] O alvo cai dentro do tronco de visao da camera?
--
-- E' a unica otimizacao que corta TRABALHO em vez de cortar bytes de um
-- trabalho ja' feito: roda antes do buildTarget, entao um alvo atras da
-- camera ou fora da tela nao custa leitura de CFrame nenhuma. Em servidor
-- cheio, a maioria dos alvos esta' fora da tela a qualquer instante.
--
-- Custo: uma leitura de Position e tres produtos escalares por alvo.
--
-- A margem de 30% deixa passar quem esta' logo fora da borda -- a caixa de
-- um alvo meio para fora ainda precisa ser desenhada, e o overlay recorta.
local function noTronco(v, cam, right, up, look, vp, fov)
    local parts = v.data and v.data.parts
    -- [NOMES DESTE JOGO -- NAO R15/R6]
    --
    -- Era `parts.HumanoidRootPart or parts.Head or parts.Torso`: nomes de rig
    -- R15/R6. Este jogo usa minusculas -- `humanoid_root_part`, `head`,
    -- `torso` -- entao `ref` era SEMPRE nil e o `return true` da linha
    -- seguinte marcava todo corpo como "no tronco". O corte nao filtrava
    -- nada (inofensivo, mas desperdica o trabalho por quadro).
    --
    -- Mesma classe do bug do PART_NAMES: nome de rig errado. Aqui o efeito e'
    -- so' desperdicio; la' o alvo saia sem geometria.
    local ref = parts and (parts.humanoid_root_part
                        or parts.HumanoidRootPart
                        or parts.torso or parts.Torso
                        or parts.head or parts.Head)
    if not ref then return true end           -- sem referencia: nao arrisca
    local ok, pos = pcall(function() return ref.Position end)
    if not ok or not pos then return true end
    local dx, dy, dz = pos.X - cam[1], pos.Y - cam[2], pos.Z - cam[3]
    local z = dx*look[1] + dy*look[2] + dz*look[3]
    if z <= 0.5 then return false end         -- atras da camera
    local ty = math.tan(math.rad((fov or 70) * 0.5)) * z * 1.3
    local tx = ty * ((vp[1] or 1) / (vp[2] or 1))
    local x = dx*right[1] + dy*right[2] + dz*right[3]
    local y = dx*up[1] + dy*up[2] + dz*up[3]
    return (x <= tx and x >= -tx and y <= ty and y >= -ty)
end

-- ==========================================================================
--  [ESTA E' A CORRECAO DO PISCAR -- E ELA NAO E' O TEAM CHECK]
-- ==========================================================================
--
-- [O DIAGNOSTICO, ESCRITO NO COLETOR ANTIGO]
--
-- O `targets` ia de 8 para 0 em rajadas, e nao era o `varreTudo` estourando
-- (o canal de erro ficou vazio), nem o envio (o `received` ficava em 70/s
-- constante), nem o servidor. Era o OVERLAY descartando:
--
--     overlay.py:2628  for _alvo in targets:
--     overlay.py:2630      _cx = caixa_do_alvo(_partes, cam)
--     overlay.py:2631      if _cx is None:
--     overlay.py:2632          continue        <<< DESCARTA
--
-- E `caixa_do_alvo` devolve None quando NENHUM dos 8 cantos de NENHUMA parte
-- projeta. Medido no coletor antigo, replicando a projecao em Python:
--
--     35 de 115 alvos  "sem canto projetado"      <<< 30% DO PACOTE
--
-- A causa, medida osso a osso:
--
--     alvo 11157494   Head=-46.4  Upper=-46.3  LeftU=-45.3
--                     Right=-46.6  Lower=-45.6  Right=-46.7
--
-- TODOS negativos. O `prof` e' a componente na direcao do OLHAR
-- (`prof = ox*lx + oy*ly + oz*lz`). Negativo = ATRAS DE MIM.
--
-- [POR QUE ISSO PISCA, E NAO SO' "NAO DESENHA"]
-- Quando TODOS os alvos do pacote estao atras da camera -- e isso acontece
-- toda vez que eu viro para um lado do mapa -- o overlay descarta o pacote
-- INTEIRO e limpa a tela. No quadro seguinte, um alvo entra na frente e a
-- tela volta. O resultado e' uma tela que liga e desliga: o PISCAR.
--
-- [EU JA' TINHA ESTE FILTRO, DESLIGADO]
-- O `noTronco` acima ja' fazia o teste do plano (`z <= 0.5`). Mas ele estava
-- atras de `if OTIM.tela`, e `OTIM.tela = false` -- eu o tratei como
-- "otimizacao de bytes" quando ele e' CORRECAO DE DESENHO.
--
-- [POR QUE NAO LIGO O `noTronco` DIRETO]
-- Porque ele TAMBEM corta por FOV (`x <= tx and x >= -tx`). O coletor antigo
-- foi explicito sobre por que isso e' errado:
--
--     "NAO filtro por FOV: quem esta' na frente mas de lado ainda e' um alvo
--      legitimo (o ESP desenha na borda da tela, e virar a camera e'
--      instantaneo). Tirar por FOV seria decidir pelo overlay, e ele ja'
--      decide -- so' que ele decide DESENHANDO, nao recebendo."
--
-- Entao eu separo as duas perguntas:
--
--     `noTronco`    -- esta' na frente E dentro do campo de visao (OTIM)
--     `naFrente`    -- esta' na frente do plano da camera (CORRECAO)
--
-- O `naFrente` e' o que impede o overlay de receber o que ele vai descartar.
-- Ele nao corta ninguem que o overlay desenharia: se o ponto esta' na frente,
-- pelo menos esse ponto projeta, e o overlay tem o que desenhar.
--
-- [A REDE] Sem `cam`, sem `look` ou sem posicao legivel, devolve `true` --
-- mandar um alvo a mais custa bytes; NEGAR um alvo valido custa o alvo na
-- tela, e ainda por cima pisca. Na duvida, manda.
local function naFrenteDaCamera(posRef, cam, look)
    if not posRef or not cam or not look then return true end
    local ok, pos = pcall(function() return posRef.Position end)
    if not ok or not pos then return true end
    local dx, dy, dz = pos.X - cam[1], pos.Y - cam[2], pos.Z - cam[3]
    local z = dx*look[1] + dy*look[2] + dz*look[3]
    -- 0.5 stud de margem: o mesmo `NEAR` do coletor antigo, e mais folgado
    -- que o zero -- evita que um corpo colado em mim fique oscilando entre
    -- "na frente" e "atras" por ruido de ponto flutuante.
    return z > 0.5
end

-- ==========================================================================
--  [BASTA UM OSSO -- O FILTRO POR CORPO INTEIRO ERA GROSSO DEMAIS]
-- ==========================================================================
--
-- [O QUE MUDOU, E POR QUE ISSO E' UM CONSERTO E NAO UM ENFEITE]
--
-- O filtro acima decide por UM ponto: a raiz. Se a raiz esta' atras do plano
-- da camera, eu DESCARTO O CORPO INTEIRO -- mesmo que a cabeca, o torso e os
-- quatro membros estejam todos na frente.
--
-- Nao e' hipotese: com o corpo deitado (ragdoll), ou com um alvo muito
-- proximo e a camera inclinada, a raiz cai para tras enquanto 5 ou 6 ossos
-- continuam projetando. Nesse caso eu jogo fora um alvo que o overlay
-- DESENHARIA.
--
-- [E' O ERRO OPOSTO AO PISCAR, E A REGRA CERTA E' A DO OVERLAY]
--
-- O overlay descarta um alvo quando `caixa_do_alvo` devolve None -- e ele
-- devolve None quando NENHUM dos 8 cantos de NENHUMA parte projeta
-- (`overlay.py:1021` e `:2628-2632`). O coletor antigo escreveu a mesma
-- regra, em palavras:
--
--     "Esta' na tela? Basta UM osso projetar. Nao e' o desenho: e' so'
--      reduzir o que sai pela rede."
--
-- Entao a pergunta certa NAO e' "a raiz esta' na frente?" e sim "ALGUM osso
-- projeta?". Sao perguntas diferentes, e a diferenca aparece exatamente nos
-- casos que hoje somem da tela sem motivo.
--
-- [POR QUE AQUI E NAO NA MONTAGEM DAS PARTES]
--
-- O `WorldToViewportPoint` custa uma leitura por osso. Feito no `buildTarget`
-- seria por parte por pacote -- e as partes ja' sao lidas la'. Feito AQUI,
-- roda uma vez por corpo por pacote, no maximo 7 osso, e so' depois que o
-- alvo passou por todos os outros filtros (entao a maioria nem chega).
--
-- [O `on` DO ROBLOX]
--
-- `WorldToViewportPoint` devolve (x, y, z, onScreen). O `onScreen` e' o
-- proprio motor respondendo "este ponto esta' dentro da tela e na frente da
-- camera" -- mais fiel que a minha conta de produto escalar, porque leva em
-- conta o near-plane e o viewport. O coletor antigo ja' o usava:
--
--     local sp, on = camera:WorldToViewportPoint(p.Position)
--     if on then pos[partName] = Vector2.new(sp.X, sp.Y) end
--
-- [A REDE] Se `WorldToViewportPoint` nao existir no executor, ou estourar,
-- cai no teste de plano da raiz -- que e' o comportamento de antes. Nunca
-- devolve "descarta" por falta de dado: um alvo a mais custa bytes, um alvo
-- a menos custa o alvo.

-- Os ossos que valem a pena testar. Nao incluo `hitbox`: e' uma caixa de
-- colisao dentro do torso, costuma estar encoberta pelas outras, e nao muda
-- o veredito de "algum osso projeta" quando os 6 de verdade ja' responderam.
local OSSOS_TESTE = {
    "head", "torso",
    "left_arm_vis", "right_arm_vis",
    "left_leg_vis", "right_leg_vis",
    "humanoid_root_part",
}

-- Algum osso deste corpo projeta na tela?
--
-- Devolve `true`/`false`. NAO devolve nil: quem chama ja' tratou o caso
-- "nao consegui medir" caindo no filtro de plano la' em cima.
local function algumOssoNaTela(partes, camera)
    -- [SEM `camera`, NAO DA'] Uso a minha conta de plano, pela raiz.
    if not camera then return true end
    -- [SEM O MAPA DE PARTES, NAO DA'] Rig desconhecido, ou o alvo ainda nao
    -- teve a geometria lida. Nao descarto por falta de dado.
    if not partes then return true end

    local okW, w2v = pcall(function() return camera.WorldToViewportPoint end)
    if not okW or type(w2v) ~= "function" then return true end

    local testou = false
    for _, nome in ipairs(OSSOS_TESTE) do
        local inst = partes[nome]
        if inst then
            testou = true
            local okP, p = pcall(function() return inst.Position end)
            if okP and p then
                -- [O `pcall` E' POR CHAMADA, NAO POR BLOCO]
                -- `WorldToViewportPoint` estoura em instancia destruida, e a
                -- janela entre o `GetChildren` e esta leitura e' real (um
                -- corpo destruido no meio da varredura). Sem o pcall, UM osso
                -- morto derrubaria a varredura do alvo inteiro.
                -- [O `on` NAO EXISTE NO XENO -- MEDIDO 18:50]
                -- A amostra do dump: `osso1=x=-4971 y=579 z=4 on=nil` --
                -- o WorldToViewportPoint do executor devolve SO' O Vector3,
                -- sem o bool de onScreen. A versao antiga exigia `on==true`,
                -- que aqui e' SEMPRE nil -> TODO corpo falhava -> alvos=0
                -- para sempre, com o ESP cego e o coletor "saudavel".
                --
                -- [O CONSERTO] comparacOes com os SEIS formatos que podem
                -- chegar, na ordem:
                --   (a) (Vector3)            -> o caso do Xeno: on = z > 0
                --   (b) (Vector3, bool)      -> o caso Roblox padrao: use bool
                --   (c) (x, y, z, on)        -> forma expandida: use os numeros
                -- E a regra de "na tela" quando on nao existe e' MANDAR --
                -- `z > 0` (na frente). Um corpo na frente mas fora do quadro
                -- custa bytes; um corpo negado errado custa o alvo na tela.
                -- O overlay descarta o que projecionar fora, em silencio.
                local okC, a, b, c, d = pcall(function()
                    return camera:WorldToViewportPoint(p)
                end)
                if okC then
                    local px, py, pz, oOn
                    if type(a) == "number" then
                        -- forma expandida (x, y, z, on)
                        px, py, pz, oOn = a, b, c, d
                    elseif a and a.X then
                        -- forma Vector3
                        px, py, pz, oOn = a.X, a.Y, a.Z, b
                    end
                    if px then
                        local pode = (oOn ~= nil) and oOn or (pz > 0)
                        if pode then
                            -- Achou UM. Nao preciso testar os outros: a regra e'
                            -- exatamente "basta um", e sair cedo aqui e' o que torna
                            -- este filtro barato no caso comum (o alvo esta' na tela).
                            return true
                        end
                    end
                end
            end
        end
    end

    -- [NENHUM OSSO EXISTE] `partes` veio vazio ou com nomes que eu nao
    -- conheco (rig diferente). Nao sei responder -- entao NAO descarto.
    if not testou then return true end

    -- Testei os ossos e nenhum projetou. Mas antes de descartar, confirmo com
    -- o teste de plano da raiz: se a raiz esta' na frente, alguma coisa esta'
    -- inconsistente (os ossos existem e estao na frente), e eu prefiro MANDAR
    -- -- o overlay descarta em silencio se nao quiser.
    --
    -- Isso cobre o caso em que `on` mente: acontece com parte dentro do
    -- near-plane, ou com o viewport ainda nao montado no primeiro quadro.
    return false
end

-- [OTIMIZACAO 3] Identidade estavel do alvo + controle de reenvio.
--
-- `id` e' um numero curto que substitui model/display/kind/team no pacote.
-- Ele vive enquanto o modelo estiver rastreado; se o alvo sumir e voltar,
-- ganha um id novo -- e o cabecalho vai junto, porque o estado e' novo.
--
-- REENVIO_S existe por um motivo so': o overlay pode subir DEPOIS do coletor.
-- Sem reenvio periodico, ele nunca saberia o nome de quem ja' estava em cena.
-- 5 s custa ~1 pacote "gordo" a cada 300 -- ruido perto do ganho.
-- (REENVIO_S e' declarado la' em cima, junto do OTIM: em Lua um `local` so'
-- existe a partir da linha da declaracao, e o precisaTamanho -- que fica
-- ANTES daqui -- tambem o usa.)
local cabecalhos = {}
setmetatable(cabecalhos, {__mode = "k"})   -- modelo sumiu, entrada some
local proximoId = 0

local function cabecalhoDe(v, agora)
    local c = cabecalhos[v.model]
    if not c then
        proximoId = proximoId + 1
        c = {id = proximoId, em = 0, marca = nil}
        cabecalhos[v.model] = c
    end
    -- [O QUE ESTA FUNCAO FAZ HOJE: SO' O `id`]
    --
    -- Ela ainda calcula `c.enviar` (marca mudou, ou passou REENVIO_S), mas
    -- NINGUEM MAIS LE'. O cabecalho do alvo passou a ir em TODO pacote --
    -- ver o bloco "BUG GRAVE: O CABECALHO CONDICIONAL" em buildPacket.
    --
    -- O motivo de continuar calculando: a marca e' o que detecta que um alvo
    -- TROCOU (display/team), e o `em` daqui e' a unica memoria de "quando
    -- este alvo foi visto pela ultima vez". Nao ha' custo: sao duas leituras
    -- e um table.concat de lista curta, por alvo por pacote.
    --
    -- Se algum dia o cabecalho voltar a ser condicional, o portao esta' aqui
    -- e funciona. Mas NAO volte sem ler o bloco do buildPacket: o servidor
    -- (vs_secure_server.py:855-859) nao guarda estado por `id`, entao o
    -- pacote magro chega ao overlay com kind='npc' -- e o aim obedece isso.
    local marca = tostring(v.display) .. "|"
               .. table.concat(v.team or {}, ",")
    c.enviar = (c.marca ~= marca) or (agora - c.em >= REENVIO_S)
    if c.enviar then
        c.marca = marca
        c.em = agora
    end
    return c
end

-- =====================================================================
-- [OTIMIZACAO 1] EMPACOTADOR BINARIO
--
-- Formato documentado em otim_bin.py -- os dois arquivos mudam JUNTOS.
-- Resumo: cabecalho de 60 B com a camera, e por alvo um bloco com id, vida,
-- flags, cabecalho opcional e as partes a 7 bytes cada (indice + 3 i16 em
-- 1/8 de stud), mais 6 bytes quando o tamanho precisa ir.
--
-- O ganho principal NAO e' o tamanho, e' nao chamar JSONEncode: serializar
-- ~600 numeros por pacote na thread do cliente e' o que pesa no fps.
--
-- Rotacao e pares de osso nao entram: a primeira o overlay nunca le, e a
-- segunda e' uma constante que os dois lados ja' conhecem.
--
-- `string.pack` existe no Luau. A checagem em tempo de execucao e' o que
-- impede a flag de emudecer um executor que nao o exponha -- sem ela, ligar
-- `bin` nesse executor daria erro a 60 Hz dentro do RenderStep.
local TEM_PACK = (type(string.pack) == "function")

-- =====================================================================
-- [OTIMIZACAO 4] WEBSOCKET
--
-- Cada POST abre uma conexao: handshake TCP, ~250 B de cabecalho, uma
-- thread no servidor. A 60 Hz sao 60 conexoes por segundo para alimentar
-- um cano que poderia ficar aberto. Aqui o cano fica aberto e cada pacote
-- custa um quadro de 2 a 14 bytes de enquadramento.
--
-- O token vai na QUERY da URL: a API de WebSocket dos executores aceita
-- apenas a URL, nao da' para mandar cabecalho. Loopback, entao a URL nao
-- sai da maquina.
--
-- Nada disto e' obrigatorio: se o executor nao expuser WebSocket, ou se a
-- conexao cair, o envio volta sozinho para o POST. O WS e' um atalho, nao
-- uma dependencia -- um canal de dados nao pode ficar refem de uma API
-- opcional do executor.
local wsSock = nil          -- conexao viva, ou nil
local wsFalhas = 0          -- tentativas seguidas que falharam
local wsProximaTentativa = 0
local WS_MAX_FALHAS = 3     -- depois disso, desiste ate' a flag ser religada

local function wsConecta()
    local conectar = (syn and syn.websocket and syn.websocket.connect)
                  or (WebSocket and WebSocket.connect)
                  or (websocket and websocket.connect)
                  or (_G.WebSocket and _G.WebSocket.connect)
    if type(conectar) ~= "function" then return nil end
    local url = "ws://127.0.0.1:" .. tostring(bridgePort)
    local ok, s = pcall(conectar, url)
    if not ok or type(s) ~= "table" and type(s) ~= "userdata" then
        return nil
    end
    -- O executor avisa o fechamento por evento; sem isto o coletor
    -- continuaria mandando para um cano morto e os pacotes sumiriam em
    -- silencio -- o modo de falha que este projeto ja' viu demais.
    pcall(function()
        if s.OnClose and s.OnClose.Connect then
            s.OnClose:Connect(function() wsSock = nil end)
        end
    end)
    return s
end

-- [SEM local] o forward acima ja' criou o local; aqui so' preenche.
function wsEnvia(corpo, ehBinario)
    if not OTIM.ws then
        if wsSock then pcall(function() wsSock:Close() end); wsSock = nil end
        return false
    end
    if not wsSock then
        if wsFalhas >= WS_MAX_FALHAS then return false end
        local agora = os.clock()
        if agora < wsProximaTentativa then return false end
        wsProximaTentativa = agora + 2
        wsSock = wsConecta()
        if not wsSock then
            wsFalhas = wsFalhas + 1
            return false
        end
        wsFalhas = 0
    end
    -- `Send` manda quadro de TEXTO na maioria dos executores, e texto passa
    -- por validacao de UTF-8: bytes crus seriam corrompidos. Por isso o
    -- binario viaja em base64 com o prefixo 'B', que o servidor reconhece.
    -- O +33% do base64 ainda deixa o pacote muito menor que o JSON.
    local msg = corpo
    if ehBinario then
        local b64 = (crypt and crypt.base64encode)
                 or (crypt and crypt.base64 and crypt.base64.encode)
                 or (base64 and base64.encode)
        if type(b64) ~= "function" then
            return false            -- sem base64: cai para o POST
        end
        local okEnc, cod = pcall(b64, corpo)
        if not okEnc then return false end
        msg = "B" .. cod
    end
    local ok = pcall(function() wsSock:Send(msg) end)
    if not ok then
        wsSock = nil
        wsFalhas = wsFalhas + 1
        return false
    end
    return true
end

local function i16(v)
    v = v // 1
    if v > 32767 then return 32767 elseif v < -32768 then return -32768 end
    return v
end

local function u16(v)
    v = v // 1
    if v > 65535 then return 65535 elseif v < 0 then return 0 end
    return v
end

local function textoCurto(s)
    s = tostring(s or "")
    if #s > 255 then s = s:sub(1, 255) end
    return string.pack("<s1", s)
end

local function montaBinario(pkt)
    local cam = pkt.camera
    local p, r, u, l = cam.pos, cam.right, cam.up, cam.look
    local vp = cam.viewport
    local pedacos = {
        string.pack("<BBBB13f2H", 0x4D, 4, 0, #pkt.targets,
            p[1], p[2], p[3], r[1], r[2], r[3],
            u[1], u[2], u[3], l[1], l[2], l[3], cam.fov or 70,
            u16(vp[1] or 1920), u16(vp[2] or 1080))
    }
    local n = 1
    for _, a in ipairs(pkt.targets) do
        local flags = 0
        if a.dead then flags = flags + 1 end
        if a.kind == "player" then flags = flags + 2 end
        local temCab = (a.display ~= nil)
        if temCab then flags = flags + 4 end
        -- [PAREDE] O bit codifica OCULTO, nao visivel: assim pacote sem a
        -- informacao (switch desligado, executor sem Raycast, coletor
        -- antigo) tem o bit em zero e o receptor le' "visivel" -- que e' o
        -- comportamento de antes. Codificar "visivel" faria todo alvo de
        -- um coletor antigo virar inalvejavel.
        if a.vis == false then flags = flags + 8 end
        n = n + 1
        pedacos[n] = string.pack("<HHHB", u16(a.id or 0),
            a.hp and u16(a.hp) or 65535,
            a.maxHp and u16(a.maxHp) or 65535, flags)
        if temCab then
            n = n + 1
            pedacos[n] = textoCurto(a.display)
            n = n + 1
            pedacos[n] = textoCurto(a.model)
            local times = a.team or {}
            local partesTime = {string.pack("<B", math.min(#times, 255))}
            for ti = 1, math.min(#times, 255) do
                partesTime[#partesTime + 1] = textoCurto(times[ti])
            end
            n = n + 1
            pedacos[n] = table.concat(partesTime)
        end
        local lista = a.parts or {}
        n = n + 1
        pedacos[n] = string.pack("<B", math.min(#lista, 255))
        for pi = 1, math.min(#lista, 255) do
            local it = lista[pi]
            local idx = it.i or it.n or 0
            if type(idx) ~= "number" then idx = PART_INDEX[idx] or 0 end
            local pos = it.p
            if it.s then
                n = n + 1
                pedacos[n] = string.pack("<Bhhh HHH", idx + 128,
                    i16(pos[1] * 8), i16(pos[2] * 8), i16(pos[3] * 8),
                    u16(it.s[1] * 64), u16(it.s[2] * 64), u16(it.s[3] * 64))
            else
                n = n + 1
                pedacos[n] = string.pack("<Bhhh", idx,
                    i16(pos[1] * 8), i16(pos[2] * 8), i16(pos[3] * 8))
            end
        end
    end
    return table.concat(pedacos)
end

-- =====================================================================
-- [PAREDE -- 7v7] VEREDITO DE LINHA DE VISAO, TRISTATE
-- =====================================================================
-- Responde UMA pergunta: "um raio reto da minha camera ate o osso do alvo
-- chega la sem barrar em geometria opaca?" E so essa. Se o SERVIDOR aceita
-- o tiro (zona, regra de time) e pergunta separada -- a zona tem raio proprio.
--
-- O veredito e TRISTATE e a diferenca importa:
--   true  -> medi e a linha esta livre
--   false -> medi e tem geometria no caminho   (o UNICO que bloqueia a mira)
--   nil   -> NAO medi (sem raycast, sem posicao, a API estourou)
-- Marcar `dead` por nil foi o bug que matou a mira inteira no 7v7: um
-- `~= true` avaliava nil como bloqueado -- 6 alvos com geometria perfeita
-- e TODOS marcados mortos. O consumo aqui so aceita `== false`.
--
-- [O CACHE E O QUE IMPEDE O CLIENTE DE CAIR] Medido no 7v7 sem cache:
-- 12 alvos x 60 Hz sao ~780 raycasts/s, o Xeno avisa "Your Roblox client
-- cannot keep up" e o pacote cai para 1 a cada 25 s. Com cache curto o
-- custo cai 4x: veredito vale ATE wallIntervalo (0.5 s) OU ate o ponto de
-- vista andar mais que wallQuantum (2.0 studs) -- abaixo disso a mudanca
-- de origem nao altera o que uma parede esconde.
--
-- [A CHAVE E A INSTANCIA, NAO O NOME] Nomes de corpo sao numeros
-- RECICLADOS neste jogo: um cadaver sai e outro nasce com o mesmo nome.
-- Veredito por nome serviria o juizo velho para um corpo novo. Chave por
-- Model em tabela FRACA (__mode = "k"): corpo destruido, entrada morre com ele.
local RAYCAST_OK = (typeof(Workspace.Raycast) == "function")
    and (typeof(RaycastParams) == "table" or typeof(RaycastParams) == "userdata")
local paramsVis = nil
local cacheParede = setmetatable({}, { __mode = "k" })
local nCacheParede = 0
-- Poda bruta: estourou o teto, joga o cache TODO fora. Veredito frio custa
-- poucos raycasts UMA vez; cache sem teto e vazamento.
local TETO_PAREDE = 96
local function baldeDe(v3)
    local q = OTIM.wallQuantum
    return math.floor(v3.X / q), math.floor(v3.Y / q), math.floor(v3.Z / q)
end

-- [O MEU CORPO PARA O FILTRO] `player.Character` e NIL neste jogo (medido
-- duas vezes): passar ele como exclusao era passar nada, e o raio que sai
-- da camera em 1a pessoa bate na MINHA propria cabeca na saida -- todo
-- alvo viraria "coberto" de mentira. O meu Model e o StarterCharacter
-- (medido: camera sempre a ~1.9 studs dele). Se o nome piscar, cai para o
-- corpo mais perto da camera (<= 12 studs), a assinatura de "a camera
-- esta montada neste corpo".
local function meuModeloRaio()
    local pasta = nil
    pcall(function() pasta = Workspace:FindFirstChild("characters") end)
    if not pasta then return nil end
    local filhos = nil
    pcall(function() filhos = pasta:GetChildren() end)
    if not filhos then return nil end
    for i = 1, #filhos do
        local nm = nil
        pcall(function() nm = filhos[i].Name end)
        if nm == "StarterCharacter" then return filhos[i] end
    end
    local camI = nil
    pcall(function() camI = Workspace.CurrentCamera end)
    local cf = nil
    if camI then pcall(function() cf = camI.CFrame end) end
    if not cf then return nil end
    local o = cf.Position
    local melhor, dMelhor = nil, 12
    for i = 1, #filhos do
        local e = nil
        pcall(function() e = filhos[i]:IsA("Model") end)
        if e then
            local p = nil
            pcall(function()
                local r = filhos[i]:FindFirstChild("humanoid_root_part")
                    or filhos[i]:FindFirstChild("torso")
                if r then p = r.Position end
            end)
            if p then
                local d = (p - o).Magnitude
                if d < dMelhor then melhor, dMelhor = filhos[i], d end
            end
        end
    end
    return melhor
end

-- [O VIEWMODEL -- IRMAO, NAO FILHO] A arma em primeira pessoa mora em
-- Workspace.ignore com "viewmodel" no nome (medido no 7v7). Sem excluir
-- ela, TODO veredito tomado com a arma levantada media o raio contra a
-- MINHA arma: o alvo ficava "coberto" de mentira. Procurado por PADRAO,
-- nao por nome fixo -- a arma troca. Lista recacheada a cada 1 s.
local VIEWMODEL_AT = 0
local VIEWMODEL_LISTA = {}
local function viewmodels()
    local agoraVM = os.clock()
    if agoraVM < VIEWMODEL_AT then return VIEWMODEL_LISTA end
    VIEWMODEL_AT = agoraVM + 1.0
    local saida = {}
    local ig = nil
    pcall(function() ig = Workspace:FindFirstChild("ignore") end)
    if ig then
        local filhos = nil
        pcall(function() filhos = ig:GetChildren() end)
        if filhos then
            for i = 1, #filhos do
                local nm = nil
                pcall(function() nm = filhos[i].Name end)
                if nm and string.find(string.lower(nm), "viewmodel", 1, true) then
                    saida[#saida + 1] = filhos[i]
                end
            end
        end
    end
    VIEWMODEL_LISTA = saida
    return saida
end

-- [A ZONA DE CESSAR-FOGO -- re-resolvida, nil NUNCA gravado] O latch de
-- nil perdeu a exclusao para a SESSAO inteira no 7v7 (D1): a primeira
-- chamada antes da replicacao de ignore/restricted e a pasta saiu do raio
-- para sempre. Aqui um nil volta a procurar na proxima chamada.
local ZONA_INST = nil
local function zonaCessarFogo()
    local ok, ainda = pcall(function() return ZONA_INST and ZONA_INST.Parent end)
    if ok and ainda then return ZONA_INST end
    pcall(function()
        local ig = Workspace:FindFirstChild("ignore")
        if ig then ZONA_INST = ig:FindFirstChild("restricted") end
    end)
    return ZONA_INST
end

-- [AS PARTES DO ALVO, LIDAS AO VIVO] O mapa `v.data.parts` e FOTO do
-- momento da leitura: parte pode ter sido criada ou destruida desde entao.
-- A identidade decide o veredito -- ela precisa ser a lista DE AGORA.
local function partesVivas(model)
    local saida = {}
    local filhos = nil
    pcall(function() filhos = model:GetChildren() end)
    if not filhos then return saida, 0 end
    local n = 0
    for i = 1, #filhos do
        local e = nil
        pcall(function() e = filhos[i]:IsA("BasePart") end)
        if e then
            n = n + 1
            saida[filhos[i]] = true
        end
    end
    return saida, n
end

-- O VEREDITO. Devolve (visivel, zonaBloqueada). `visivel` pode ser nil
-- (NAO MEDIDO). `zonaBloqueada` so vale false quando o raio de zona roda.
local function paredeVeredito(camPos, model, parts)
    if not RAYCAST_OK then return nil, nil end
    if typeof(model) ~= "Instance" then return nil, nil end
    -- O osso do alvo: a cabeca primeiro (e o osso da mira), depois torso,
    -- depois a raiz. Testar so a cabeca daria falso negativo a cada vez
    -- que um batente cobre so a cabeca com o corpo exposto -- por isso o
    -- torso entra na fila antes da raiz.
    local alvoParte = parts and (parts.Head or parts.UpperTorso or parts.Torso
                                 or parts.HumanoidRootPart or parts.LowerTorso)
    local inst = alvoParte and (alvoParte.part or alvoParte)
    if not inst or typeof(inst) ~= "Instance" then return nil, nil end
    local okPos, destino = pcall(function() return inst.Position end)
    if not okPos or not destino then return nil, nil end

    local origem = Vector3.new(camPos[1], camPos[2], camPos[3])
    -- [CACHE] chave por instancia; o valor guarda o balde de origem e o relogio
    local bx, by, bz = baldeDe(origem)
    local agoraW = os.clock()
    local antigo = cacheParede[model]
    if antigo and (agoraW - antigo.quando) < OTIM.wallIntervalo
        and antigo.bx == bx and antigo.by == by and antigo.bz == bz then
        return antigo.visivel, antigo.zona
    end

    local delta = destino - origem
    local dist = delta.Magnitude
    -- Colado demais para haver parede entre eu e ele: LIVRE (e nao nil --
    -- nil aqui seria "nao medido", e um alvo grudado em mim e visivel).
    if dist < 0.5 then return true, false end

    local partesAlvo = partesVivas(model)
    local meuM = meuModeloRaio()

    -- [RAIO DE LUZ] O alvo NAO entra no filtro (licao D2 do 7v7): ele fica
    -- no raio, e a identidade e decidida pelo RESULTADO -- se o que o raio
    -- acertou e uma parte do PROPRIO alvo, a linha chegou nele. sair do
    -- filtro: o meu corpo (o raio nasce dentro da minha cabeca), a arma
    -- (viewmodel) e a zona (barreira invisivel: se ela ficasse aqui, o
    -- veredito de LUZ mentiria -- no 7v7, 9/9 alvos "cobertos" por causa
    -- dela). O fato "o tiro e proibido ali" e o SEGUNDO raio, la embaixo.
    local visivel = nil
    local okRay = pcall(function()
        if not paramsVis then
            paramsVis = RaycastParams.new()
            paramsVis.FilterType = Enum.RaycastFilterType.Exclude
            paramsVis.IgnoreWater = true
        end
        local f = {}
        if meuM then f[#f + 1] = meuM end
        local vms = viewmodels()
        for i = 1, #vms do f[#f + 1] = vms[i] end
        local z = zonaCessarFogo()
        if z then f[#f + 1] = z end
        paramsVis.FilterDescendantsInstances = f
        local res = Workspace.Raycast(Workspace, origem, delta, paramsVis)
        if not res then
            visivel = true
        else
            local hit = nil
            pcall(function() hit = res.Instance end)
            if hit and partesAlvo[hit] then
                visivel = true
            else
                visivel = false
            end
        end
    end)
    if not okRay then
        -- [RESERVA] API antiga, se o Raycast estourar. FindPartOnRay aceita
        -- UMA instancia para ignorar: vai a minha. A identidade do alvo
        -- vale do mesmo jeito -- se as duas APIs respondessem diferente
        -- para a MESMA cena, a reserva diria que todo alvo esta coberto.
        local ok2 = pcall(function()
            local r = Ray.new(origem, delta)
            local hit = Workspace:FindPartOnRay(r, meuM, false, true)
            if hit == nil or partesAlvo[hit] then
                visivel = true
            else
                visivel = false
            end
        end)
        if not ok2 then visivel = nil end
    end

    -- [SEGUNDO RAY -- A ZONA] A zona saiu do filtro do raio de luz; aqui
    -- ela INCLUI: se o segmento toca a pasta restricted/, o tiro e
    -- proibido ali dentro. Fato separado da luz -- a mira precisa dos dois,
    -- e fundir os dois num booleano so foi o defeito que o 7v7 pagou caro
    -- para descobrir. Zona sem CanQuery responde nil (harmless: zona
    -- bloqueada = false).
    local zonaBloq = false
    if OTIM.wallZona then
        local z = zonaCessarFogo()
        if z then
            pcall(function()
                local pz = RaycastParams.new()
                pz.FilterType = Enum.RaycastFilterType.Include
                pz.FilterDescendantsInstances = { z }
                pz.IgnoreWater = true
                zonaBloq = Workspace.Raycast(Workspace, origem, delta, pz) ~= nil
            end)
        end
    end

    -- [GRAVA NO CACHE] com o balde de origem -- andar menos que o quantum
    -- nao revalida; andar mais, sim.
    if cacheParede[model] == nil then
        nCacheParede = nCacheParede + 1
        if nCacheParede > TETO_PAREDE then
            cacheParede = setmetatable({}, { __mode = "k" })
            nCacheParede = 0
        end
    end
    cacheParede[model] = { visivel = visivel, zona = zonaBloq,
                           quando = agoraW, bx = bx, by = by, bz = bz }
    return visivel, zonaBloq
end

