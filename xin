local TEAM_TAGS = {
red = "red", blue = "blue", vermelho = "red", azul = "blue",
["time vermelho"] = "red", ["time azul"] = "blue",
}
local COR_TOL = 0.06
local COR_RED = {1.0, 0.235, 0.235}
local COR_BLUE = {0.0, 0.470, 1.0}
local COR_PROPS = {"BackgroundColor3", "TextColor3", "ImageColor3", "BorderColor3"}
local function tagFromColor(c)
if typeof(c) ~= "Color3" then return nil end
local rd, gd, bd = math.abs(c.R - COR_RED[1]), math.abs(c.G - COR_RED[2]),
math.abs(c.B - COR_RED[3])
if rd <= COR_TOL and gd <= COR_TOL and bd <= COR_TOL then return "red" end
local rb, gb, bb = math.abs(c.R - COR_BLUE[1]), math.abs(c.G - COR_BLUE[2]),
math.abs(c.B - COR_BLUE[3])
if rb <= COR_TOL and gb <= COR_TOL and bb <= COR_TOL then return "blue" end
return nil
end
local function tagFromName(s)
if type(s) ~= "string" then return nil end
local low = string.lower(s)
for chave, tag in pairs(TEAM_TAGS) do
if string.find(low, chave, 1, true) then return tag end
end
return nil
end
local function guiTag(obj)
for _, prop in ipairs(COR_PROPS) do
local c = obj[prop]
if typeof(c) == "Color3" then
local t = tagFromColor(c)
if t then return t end
end
end
local t2 = tagFromName(obj.Name)
if t2 then return t2 end
if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
local t3 = tagFromName(obj.Text)
if t3 then return t3 end
end
return nil
end
