-- Medido: todo corpo tem exatamente estas partes --
--     head, torso, left_arm_vis, right_arm_vis, left_leg_vis, right_leg_vis,
--     humanoid_root_part, hitbox
-- Nao existe HumanoidRootPart. O FindFirstChild("HumanoidRootPart", true)
-- devolvia nil para os 12 corpos e o registerModel saia no `return end` --
-- entao `tracked` ficava VAZIO, `vivos` ficava VAZIO e todo pacote saia com
-- zero alvos. Medido no servidor: received=5503, targets=0, com o filtro de
-- time DESLIGADO. O team check nao tinha o que filtrar.
--
-- humanoid_root_part = corpo em pe'  (na T2 estava em -704.4)
-- torso              = corpo no chao (ragdoll)
local RAIZES = { "HumanoidRootPart", "humanoid_root_part", "torso", "Torso",
                 "hitbox", "UpperTorso", "Head", "head" }

-- [UMA PASSADA, NAO OITO BUSCAS RECURSIVAS]
--
-- A versao anterior fazia `FindFirstChild(nome, true)` para CADA um dos 8
-- nomes, e `true` significa RECURSIVO -- varre a subarvore inteira do modelo
-- oito vezes. Com milhares de Models na varredura inicial isso ficou LENTO
-- (medido: o jogo engasgou logo apos injetar).
--
-- Agora e' uma passada so' sobre os filhos DIRETOS, montando um mapa de
-- nome -> parte. Os corpos deste jogo tem as 8 partes no primeiro nivel, e o
-- overlay nao precisa de mais que isso.
--
-- Fallback: se o modelo for fundo (corpo aninhado em pasta), ainda tentamos
-- recursivo UMA vez com o nome mais provavel -- nao oito.
local function achaRaiz(model)
    local achados = {}
    local ok, filhos = pcall(function() return model:GetChildren() end)
    if ok and filhos then
        for i = 1, #filhos do
            local o = filhos[i]
            local okB, ehBase = pcall(function() return o:IsA("BasePart") end)
            if okB and ehBase then
                achados[o.Name] = o
            end
        end
    end
    for _, nome in ipairs(RAIZES) do
        local r = achados[nome]
        if r then return r end
    end
    -- corpo aninhado: uma unica busca recursiva, pelo nome mais provavel
    local ok2, r2 = pcall(function() return model:FindFirstChild("humanoid_root_part", true) end)
    if ok2 and r2 then return r2 end
    return nil
end

local function registerModel(model)
    if not model or not model:IsA("Model") then return end
    if model == player.Character then return end
    if tracked[model] then return end
    local root = achaRaiz(model)
    if not root then return end
    if not isAlive(model) then return end
    local owner = resolveOwner(model)
    if owner == player then return end
    if CONFIG.IGNORE_ANCHORED_NPCS and not owner and root.Anchored then return end


    local data = {model = model, owner = owner, parts = {}, slots = {},
                  gen = 0, connections = {}}
    refreshParts(data)
    tracked[model] = data

    local function bind(signal, fn)
        local c = signal:Connect(fn)
        table.insert(data.connections, c)
    end
    bind(model:GetAttributeChangedSignal("Team"), function() TEAM_CACHE[model] = nil end)
    bind(model:GetAttributeChangedSignal("TeamColor"), function() TEAM_CACHE[model] = nil end)
    -- [CORRECAO] O cache de time so' morria em Team/TeamColor. Qualquer OUTRO
    -- campo de CONFIG.TEAM_FIELDS (GamemodeTeam, Faction, ...) e os
    -- ValueObjects filhos mudavam sem invalidar nada: o overlay ficava com a
    -- cor velha por ate' TEAM_REFRESH. Aqui a invalidacao passa a ser
    -- explicita para todo mundo que escreve essas chaves, e o cache de
    -- pacote tambem cai (a etiqueta de time entra no JSON).
    local function invalidate(entity)
        if entity then TEAM_CACHE[entity] = nil end
        bridgeLastSig = nil
    end
    bind(model.AttributeChanged, function() invalidate(model) end)
    bind(model.DescendantAdded, function(inst)
        if inst:IsA("ValueBase") then
            invalidate(inst.Parent)
        elseif inst:IsA("BasePart") and PART_SET[inst.Name] then
            -- [RIG] Um rig novo pode ser montado no MESMO Model. O gen forca
            -- os slots a nascerem limpos, senao o cache serviria a posicao
            -- de uma parte que nao existe mais (ESP preso no ceu).
            data.gen = data.gen + 1
            bridgeLastSig = nil
            refreshParts(data)
        end
    end)
    bind(model.DescendantRemoving, function(inst)
        if inst:IsA("BasePart") and PART_SET[inst.Name] then
            task.defer(function()
                if tracked[model] then
                    data.gen = data.gen + 1
                    bridgeLastSig = nil
                    refreshParts(data)
                end
            end)
        end
    end)
end

local function removeModel(model)
    local data = tracked[model]
    if not data then return end
    for _, c in ipairs(data.connections) do
        pcall(function() c:Disconnect() end)
    end
    tracked[model] = nil
    TEAM_CACHE[model] = nil
    -- [HISTERESE] O corpo saiu: o veredito memorizado dele morre junto.
    -- Um corpo novo com o mesmo Model comeca sem lado e e' reavaliado.
    if TC and TC.esquecer then pcall(TC.esquecer, model) end
    -- [ALVOVIDA] `alvoVida[model]` guardava o ultimo estado lido. Deixar a
    -- entrada aqui faria `listaViva` consultar a vida de um corpo que ja'
    -- saiu do `tracked`.
    alvoVida[model] = nil
    -- [CACHE] Um modelo que sai e outro que entra com o MESMO nome poderia
    -- reaproveitar um pacote velho. O modelo nunca foi cacheado por nome,
    -- mas o proximo pacote tem de sair de qualquer jeito.
    bridgeLastSig = nil
end

