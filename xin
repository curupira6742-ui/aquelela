--                               quadradinho escondido por fumaca/parede nao
--                               reabre o ESP)
-- Confirmacao em 2 pacotes seguidos (MALRUA = a sequencia por corpo): evita
-- travar um INIMIGO que passou a 40 px do marcador de um aliado num frame
-- ruim. Travou, nao destrava -- simetria com a regra da zona.
local MALIADOS_NICK = {}
local MALIADOS_CORPO = {}
local MALRUA = {}
