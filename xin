-- [DIAGNOSTICO DA CARGA -- O QUE FALHOU, E ONDE]
--
-- A sonda SONDA_VIVO mediu `tcExiste: false` com `coletorRegistrado: true`:
-- o coletor inteiro rodou, chegou na ultima linha, e o modulo NAO carregou.
-- `if ok and type(r) == "table"` nao distingue as duas causas:
--
--   (a) `loadstring` recusou o texto   -> chunk == nil, vem com a mensagem
--   (b) o texto compilou e estourou    -> ok == false, vem o erro
--
-- As duas caem no mesmo `TC = nil` e o coletor segue com o filtro desligado.
-- Agora cada uma guarda o motivo em TC_ERRO, e o pacote publica o campo.
-- [TEAM CHECK POR ZONA -- REMOVIDO A PEDIDO]
--
-- O filtro geometrico (attack_spawns/defend_spawns -> eixo -> plano ->
-- "estou do mesmo lado?") foi DESLIGADO. Ele classificava por posicao no mapa,
-- e neste jogo isso nao se sustenta:
--
--   * o placar nao entrega o time (medido: os nomes Tag_UserId do placar sao
--     `bar_0`, `preload_2` -- UI, nao jogador). Nao ha' UserId para cruzar.
--   * nenhum atributo de time nos corpos (medido: campos vazios em todos).
--   * o plano caiu repetidamente no MEIO do proprio time -- medido em duas
--     sessoes: plano z=-275 com um aliado em z=-296 e eu em z=-435.
--
-- Custo observado: aliado desenhado, inimigo sumindo ao andar, e falso
-- "desconhecido" quando o corpo chegava perto da linha.
--
-- O modulo continua no arquivo, inteiro, logo acima -- nao apaguei nada. Ele
-- so' nao e' mais carregado. Para religar: troque `false` por `true` aqui.
-- Nada mais precisa mudar.
--
-- [TEM DE VIR ANTES DO USO] Em Lua um `local` so' existe a partir da propria
-- declaracao. Enquanto esta linha viveu abaixo, o `if` que a le' via nil --
-- ou seja, o modulo carregava mesmo com o time check "desligado", e a medicao
-- continuava escrevendo `coletor_tc_lado.txt` a cada 2 s.
local TEM_TEAM_CHECK = true

local TC = nil
local TC_ERRO = nil

-- [O MODULO NAO E' MAIS CARREGADO]
--
-- Antes isto compilava e rodava `FONTE_TC` a cada injecao. Agora o bloco so'
-- executa quando o team check esta' ligado. Desligado, nao ha' loadstring, nao
-- ha' medicao, nao ha' `coletor_tc_lado.txt` e nao ha' trabalho por quadro.
--
-- O texto do modulo continua no arquivo, intacto -- e' so' nao executado.
if TEM_TEAM_CHECK then
    local temLS = (type(loadstring) == "function")
    if not temLS then
        TC_ERRO = "executor sem loadstring"
    else
        local chunk, errComp = loadstring(FONTE_TC, "team_check_eixo")
        if not chunk then
            TC_ERRO = "loadstring recusou: " .. tostring(errComp)
        else
            local ok, r = pcall(chunk)
            if not ok then
                TC_ERRO = "modulo estourou ao rodar: " .. tostring(r)
            elseif type(r) ~= "table" then
                TC_ERRO = "modulo devolveu " .. type(r) .. " (esperava table)"
            else
                TC = r
            end
        end
    end
    -- [SEM warn/print -- O COLETOR NAO ESCREVE NO CONSOLE DO JOGO]
    --
    -- A versao anterior chamava warn(), que aparece no F9 do Roblox. Regra
    -- do projeto: o coletor nao imprime NADA no jogo. Ele so' LE o mundo e
    -- manda por HTTP local para o nos. Quando o modulo do team check falha
    -- ao carregar, o motivo vai para um arquivo no workspace do executor --
    -- disco local, fora do Roblox -- e o coletor segue SEM filtro nenhum.
    if TC_ERRO and type(writefile) == "function" then
        pcall(writefile, "coletor_tc_erro.txt",
            "erro ao carregar o modulo do team check:\n"
            .. tostring(TC_ERRO) .. "\n")
    end
end


-- [O CONTRATO DO MODULO DE ZONA]
--
-- `TC.veredito(nome, pos)` -> true (aliado) | false (inimigo) | nil (pendente)
-- `TC.estado()`           -> diagnostico, so' para o /health
--
-- Diferente do modulo antigo, que devolvia "entra no pacote ou nao" e
-- escondia a decisao dentro dele. Aqui o modulo diz O LADO e o coletor decide
-- o que fazer -- assim "pendente" e' um valor distinto de "inimigo" em vez de
-- se confundir com ele.
local tcVeredito
local tcEstado
if TEM_TEAM_CHECK and TC then
    tcVeredito = TC.veredito
    tcEstado = TC.estado
else
    tcVeredito = function() return nil end
    tcEstado = function() return { carregou = false, desligado = true } end
end
local tcFiltrados = 0
-- Erros levantados DENTRO do filtro de time, por alvo. Diagnostico: se isto
-- subir, o filtro esta' falhando e o veredito dele nao vale -- e' o sinal que
-- antes ficava invisivel porque o pcall virava `entra = true` em silencio.
local tcErrosFiltro = 0
-- [DIAGNOSE VIVA] relogio do despejo em disco (ver o fim de buildPacket).
-- Declarado AQUI porque em Lua `local` so' existe da linha para baixo --
-- declarar dentro do `if` do fim deixaria a primeira passagem com nil.
local tcVivoUlt = nil
-- [CONTADORES DA CADEIA DE CAMERA] por pacote, despejados a cada 2 s no
-- `coletor_tc_vivo.txt`. Com eles, "alvos=0" deixa de ser um enigma: cada
-- filtragem tem o seu numero, e quem esvazia o pacote assina embaixo.
--   vivos       = quantos sairam de `listaViva` (candidatos de verdade)
--   troncoFora  = barrou o noTronco (flag OTIM.tela, hoje OFF)
--   ossoFora    = "nenhum osso projeta" reprou todos
--   frenteFora  = a rede do plano da raiz reprou
local cVivos, cTroncoFora, cOssoFora, cFrenteFora = 0, 0, 0, 0
local cNickAliado = 0
-- [PAREDE] alvos que o veredito de parede marcou `dead` neste pacote
-- (coberto OU zona de cessar-fogo). Vai no dump: se a mira parar de
-- travar, este numero diz se o wall check e o autor.
local wBloqParede = 0
local function buildPacket(camData, myIds, myFlat, myKeys, agora, myKeysInfo, camera)
    -- [ABA CONFIG] Rela os flags do painel no maximo 1x a cada 2 s (ver
    -- OTIM.RECARGA). Sem isto, mexer num switch do overlay so' teria
    -- efeito reiniciando o coletor -- porque o discoverBridge le' o
    -- ui_cache.json UMA vez e nunca mais volta la'.
    OTIM.recarrega()
    -- [O `camera` E' A INSTANCIA, NAO O DICT]
    --
    -- O `camData` so' traz os VETORES ja' convertidos (pos/right/up/look).
    -- O filtro "basta um osso" precisa da INSTANCIA da camera, porque e' ela
    -- que sabe projetar (`WorldToViewportPoint`). Sao duas coisas diferentes
    -- e por isso sao dois parametros.
    --
    -- [POR QUE POR PARAMETRO E NAO POR GLOBAL]
    -- Eu escrevi a primeira versao lendo uma global `cameraAtual` -- que NAO
    -- EXISTE neste arquivo. Ela seria `nil`, o `algumOssoNaTela` devolveria
    -- `true` na primeira linha por falta de camera, e o filtro novo NUNCA
    -- RODARIA -- em silencio, que e' a pior forma de um filtro falhar.
    -- Passando por parametro, o compilador e' quem cobra o valor.
    local cam = camData.pos
    local right = camData.right
    local up = camData.up
    local look = camData.look
    local vp = camData.viewport
    -- Arredondar para inteiro e' o que torna o repouso reconhecivel: o
    -- jogador parado tem micro-tremor de camera, e sem isso o portao nunca
    -- fecharia. 1 pixel e' o limite do que o overlay consegue desenhar.
    local csig = "C" .. math.floor(cam[1]) .. "," .. math.floor(cam[2]) .. ","
              .. math.floor(cam[3]) .. ","
              .. math.floor(right[1]) .. "," .. math.floor(right[2]) .. ","
              .. math.floor(right[3]) .. ","
              .. math.floor(up[1]) .. "," .. math.floor(up[2]) .. ","
              .. math.floor(up[3]) .. ","
              .. math.floor(look[1]) .. "," .. math.floor(look[2]) .. ","
              .. math.floor(look[3]) .. ","
              .. math.floor(vp[1]) .. "," .. math.floor(vp[2])

    -- Lista de alvos vivos, ja' filtrada sem alocacao por modelo.
    listaViva(agora)

    -- [CONTADORES DA CADEIA] zera no comeco do pacote (dump no fim dele).
    cVivos = #vivos
    cTroncoFora = 0
    cOssoFora = 0
    cFrenteFora = 0
    cNickAliado = 0
    -- [O ALTAR DE COMBATE] os casamentos do pacote anterior viraram NICK
    -- fresco (validade 3 s no MCorpo); a janela de casamento deste pacote
    -- comeca em branco pra nao casar aliado antigo duas vezes.
    for nomeCorpo, info in pairs(MCorpo) do
        if (agora - info.em) > 3 then MCorpo[nomeCorpo] = nil end
        -- o corpo que virou aliado travado nao precisa mais de codinome
        if MALIADOS_CORPO[nomeCorpo] then MPIN[nomeCorpo] = nil end
    end

    tcFiltrados = 0
    wBloqParede = 0
    local targets = {}
    local sig = {csig}
    local nS = 1
    -- Namespace PROPRIO para "as partes obsoletas ja' foram removidas".
    -- O renderstep pode ser reexecutado varias vezes por quadro; sem a
    -- marca, a limpeza rodaria de novo em cada passada e o `parts` seria
    -- varrido a toa. Com contador monotonico isso acontece uma vez por quadro.
    local cacheIds = {}
    for i = 1, #vivos do
        local v = vivos[i]
        -- ["tela"] Fora do tronco de visao: nem monta a malha deste alvo.
        if OTIM.tela and not noTronco(v, cam, right, up, look, vp, camData.fov) then
            cTroncoFora = cTroncoFora + 1
            continue
        end
        -- [TEAM CHECK POR ZONA RESTRITA]
        --
        -- Esconde quem pisou numa zona aliada. Ver o bloco de chamada mais
        -- abaixo, junto da leitura da raiz.
        --
        -- [A RAIZ VEM DO achaRaiz] data.parts pode nao ter
        -- HumanoidRootPart/Head/Torso: este jogo nomeia as partes
        -- com minusculas e underscore (humanoid_root_part).
        local posV = nil
        -- [CACHE POR ALVO] achaRaiz varre filhos; fazer isso por QUADRO
        -- por alvo e' desperdicio -- a raiz de um corpo nao muda. Guarda
        -- em `v` e so' refaz se a referencia morrer.
            --
            -- `v.__raiz` tem TRES estados e isso importa:
            --   nil   -> nunca procurou
            --   false -> procurou e NAO achou (nao repete a busca a toa)
            --   part  -> achou
            local rCache = v.__raiz
            if rCache == nil or (rCache ~= false and rCache.Parent == nil) then
                local okR, r = pcall(achaRaiz, v.model)
                rCache = (okR and r) or false
                v.__raiz = rCache
            end
            if rCache ~= false then
                local okP, pp = pcall(function() return rCache.Position end)
                if okP then posV = pp end
            end
            -- ==========================================================
            -- [A CORRECAO DO PISCAR -- ESTE FILTRO E' OBRIGATORIO]
            -- ==========================================================
            --
            -- O overlay DESCARTA todo alvo que nao projeta nenhum canto
            -- (`overlay.py:2631`, `if _cx is None: continue`), e ele tem
            -- razao: um corpo atras de mim tem os 6 ossos com profundidade
            -- negativa e nao projeta nada.
            --
            -- [POR QUE ISSO PISCA] Quando o pacote inteiro e' de corpos
            -- atras da camera, o overlay descarta TUDO e limpa a tela -- e
            -- ela volta no quadro seguinte, quando eu viro. Medido no
            -- coletor antigo: 30% dos alvos (35 de 115) caiam nesse caso.
            --
            -- [O QUE EU FACO] Nao mando o que ele vai jogar fora. Assim
            -- "lista vazia" passa a significar de verdade "nao tem ninguem
            -- para desenhar", que o overlay trata limpando a tela de forma
            -- ESTAVEL.
            --
            -- [DIFERENTE DO noTronco] Aqui NAO ha' corte por FOV. Quem esta'
            -- na frente mas de lado continua indo -- e' alvo legitimo (o ESP
            -- desenha na borda) e virar a camera e' instantaneo.
            --
            -- [A POSICAO VEM DO posV, AQUI DE CIMA -- NAO DE v.data.raiz]
            -- Eu escrevi a primeira versao deste filtro lendo `v.data.raiz`,
            -- que NAO EXISTE -- o filtro devolveria `true` por falta de dado
            -- e nao filtraria nada, em silencio.
            --
            -- E ele TINHA de vir depois do `posV`: escrito antes, `posV`
            -- seria o global `nil` (em Lua, `local` so' existe da linha da
            -- declaracao para baixo) e TODO alvo sairia por "sem posicao".
            --
            -- ==========================================================
            -- [AGORA E' "BASTA UM OSSO", NAO "A RAIZ ESTA' NA FRENTE"]
            -- ==========================================================
            --
            -- O filtro de plano da raiz era grosso demais: corpo deitado
            -- (ragdoll) ou alvo muito proximo com a camera inclinada jogam a
            -- RAIZ para tras enquanto 5 ou 6 ossos continuam projetando. Eu
            -- descartava um alvo que o overlay DESENHARIA.
            --
            -- A regra certa e' a do proprio overlay (`overlay.py:1021`):
            -- descarta so' quando NENHUM canto de NENHUMA parte projeta. E o
            -- coletor antigo escreveu a mesma coisa, em palavras: "basta UM
            -- osso projetar".
            --
            -- [A ORDEM DAS DUAS PERGUNTAS]
            --
            --   `algumOssoNaTela` responde "da' para desenhar?" -- com o
            --   `onScreen` que o Roblox calcula, osso a osso.
            --
            --   `naFrenteDaCamera` continua aqui como REDE: quando o
            --   `WorldToViewportPoint` nao existe ou o rig nao tem nenhum osso
            --   conhecido, `algumOssoNaTela` devolve `true` e quem decide
            --   volta a ser o plano da raiz.
            --
            -- Ou seja: as duas nao se somam, elas se cobrem. Um alvo so' sai
            -- quando ALGUMA delas diz "nao da' para desenhar" -- e a segunda
            -- so' fala quando a primeira nao teve como medir.
            local partesDoAlvo = v.data and v.data.parts
            if not algumOssoNaTela(partesDoAlvo, camera) then
                cOssoFora = cOssoFora + 1
                continue
            end
            if not naFrenteDaCamera(posV, cam, look) then
                cFrenteFora = cFrenteFora + 1
                continue
            end
            -- [A PONTE NICK -- O QUADRADO DO JOGO, COM A REGRA DE 1 VEZ]
            --
            -- Casou o quadradinho VISIVEL (70x100 px) com a projecao do
            -- corpo -> nick real + candidato a aliado confirmado. O DONO
            -- pediu: confirmado 1 vez pelo quadradinho, esse player NUNCA
            -- mais aparece no ESP ate o fim da partida. Confirmacao = o
            -- MESMO corpo casar o MESMO nick em 2 pacotes SEGUIDOS (um
            -- casamento de frame ruim nao trava inimigo que passou perto
            -- do marcador de um aliado: a sequencia quebra sem casar).
            -- Travado por nick E por corpo: o nick cobre respawn (novo id
            -- de corpo ja' nasce escondido), o corpo cobre o quadradinho
            -- que o jogo esconde (fumaca/parede) sem reabrir o ESP.
            local nomeCorpo = v.modelName
            local nickAqui = nil
            local jaTravado = MALIADOS_CORPO[nomeCorpo] or nil
            local partesRaiz = partesDoAlvo and (partesDoAlvo["humanoid_root_part"]
                or partesDoAlvo["torso"] or partesDoAlvo["head"])
            nickAqui = casaNick(nomeCorpo, partesRaiz, camera, agora)
            if nickAqui then
                MALRUA[nomeCorpo] = (MALRUA[nomeCorpo] or 0) + 1
                if MALRUA[nomeCorpo] >= 2 then
                    if not MALIADOS_NICK[nickAqui] then
                        MALIADOS_NICK[nickAqui] = true
                        MLockN = MLockN + 1
                        -- [O PIN SOLTO] se algum corpo estava usando esse
                        -- nick como CODINOME de inimigo, solta: no proximo
                        -- pacote ele re-pin com o pool corrigido (sem esse
                        -- nick, que agora e' comprovadamente de aliado)
                        for corpoPin, nickPin in pairs(MPIN) do
                            if nickPin == nickAqui then MPIN[corpoPin] = nil end
                        end
                    end
                    if not MALIADOS_CORPO[nomeCorpo] then
                        MALIADOS_CORPO[nomeCorpo] = true
                        MLockC = MLockC + 1
                    end
                end
            else
                MALRUA[nomeCorpo] = nil
            end
            if jaTravado
               or (nickAqui and MALIADOS_NICK[nickAqui]) then
                cNickAliado = cNickAliado + 1
                continue
            end
            -- [TEAM CHECK POR ZONA RESTRITA -- ATIVO]
            --
            -- A REGRA, DO JEITO QUE O DONO PEDIU: "quem nascer em uma zona
            -- restrita inimiga vai ser considerado inimigo pelo resto da
            -- partida". E o avesso: "um aliado que nasceu na zona aliada e
            -- passar perto de uma inimiga AINDA vai ser aliado".
            --
            -- `tcVeredito(nome, pos)` devolve:
            --
            --     true   -> ALIADO   -- nasceu em zona aliada
            --     false  -> INIMIGO  -- nasceu em zona inimiga
            --     nil    -> PENDENTE -- nasceu fora de zona; ainda nao pisou
            --
            -- O veredito e' tirado UMA vez e travado: uma vez ALIADO, sempre
            -- escondido -- mesmo entrando na zona inimiga para capturar.
            -- Uma vez INIMIGO, sempre desenhado -- mesmo entrando na aliada.
            -- A chave da memoria e' o NOME DO CORPO, que sobrevive ao
            -- respawn, e a travada vale ATE O FIM DA PARTIDA.
            if TEM_TEAM_CHECK then
                local okT, lado = pcall(tcVeredito, v.model and v.model.Name, posV)
                if okT then
                    -- So' o ALIADO confirmado sai. Pendente e inimigo entram.
                    if lado == true then
                        tcFiltrados = tcFiltrados + 1
                        continue
                    end
                else
                    -- [ERRO NO FILTRO NAO E' UM VEREDITO]
                    --
                    -- O erro e' CONTADO e gravado em disco (sem tocar no
                    -- console do jogo). O alvo entra -- derrubar o pacote por
                    -- causa do filtro seria pior --, mas o defeito fica
                    -- visivel em vez de silencioso. Um filtro que falha em
                    -- TODO alvo e cai no "entra" fica decorativo sem avisar.
                    tcErrosFiltro = tcErrosFiltro + 1
                    if tcErrosFiltro <= 3 and type(writefile) == "function" then
                        pcall(writefile, "coletor_tc_erro.txt",
                            "ERRO NO FILTRO #" .. tcErrosFiltro .. ": "
                            .. tostring(lado) .. "\n")
                    end
                end
            end

        local slot = rascunho[v]
        if not slot then
            slot = {keys = nil}
            rascunho[v] = slot
        end
        slot.parts = {}
        if v.obsoleto ~= OBSOLETO_FN then
            v.obsoleto = OBSOLETO_FN
            partsParaLimpar = slot.parts
            descartarObsoletas()
        end
        local ok, parts, tsig, nPartes = pcall(buildTarget, v, slot, agora)
        if ok and parts then
            -- [OTIMIZACAO 3 -- CABECALHO SO' QUANDO MUDA]
            -- model/display/kind/team iam inteiros em todo pacote, 60x/s,
            -- para valores que mudam uma vez por partida (`display` e' texto).
            -- Agora vai um `id` estavel e os campos so' na primeira vez, na
            -- mudanca, ou no reenvio periodico de seguranca (REENVIO_S) --
            -- que existe para um overlay que subiu DEPOIS do coletor nao
            -- ficar sem o nome do alvo para sempre.
            local cab = cabecalhoDe(v, agora)
            local visDesteAlvo = nil
            local zonaDesteAlvo = nil
            if OTIM.vis then
                visDesteAlvo, zonaDesteAlvo =
                    paredeVeredito(cam, v.model, v.data.parts)
            end
            -- ==========================================================
            -- [PAREDE -> dead -- A UNICA ROTA QUE CHEGA NA MIRA]
            -- ==========================================================
            -- O campo `vis` abaixo segue no pacote e o servidor o DESCARTA
            -- (a tupla tem 9 campos; vis e o 10o). O `dead` e quem chega:
            -- overlay.py:1036 faz `if dead: continue` na MIRA e o ESP
            -- ignora dead (2514/2555) -- pelo coberto continua desenhado,
            -- e o aim nao trava nele. "So wall check no aimbot".
            --
            -- [SOMENTE VEREDITO MEDIDO BLOQUEIA] `false` medido entra no
            -- OR; `nil` (nao medido: sem raycast, API estourou) NAO entra
            -- -- o `~= true` do 7v7 transformava nao-medido em morto e a
            -- mira ficava cega para todo mundo. Zona de cessar-fogo no
            -- caminho tambem marca (o tiro e proibido ali dentro).
            local deadParede = false
            if OTIM.vis then
                if visDesteAlvo == false then deadParede = true end
                if OTIM.wallViaDead and zonaDesteAlvo == true
                    then deadParede = true end
            end
            if deadParede then wBloqParede = wBloqParede + 1 end
            local alvo = {
                id = cab.id,
                hp = v.health,
                maxHp = v.maxHealth,
                dead = (v.deadNow and true) or deadParede,
                -- [PAREDE] fica nil quando o switch esta desligado ou o
                -- executor nao tem Raycast. O receptor tracado de antes
                -- (tratar nil como visivel) continua valendo: nil nunca
                -- entra no OR do dead acima. NAO pode ser
                -- `OTIM.vis and f(...) or nil`: alvo COBERTO devolve
                -- `false`, e `or nil` transformaria justamente ele em
                -- "sem informacao".
                vis = visDesteAlvo,
                -- [BUG: `parts` E' O ALVO INTEIRO, NAO A LISTA DE PARTES]
                --
                -- O buildTarget devolve TRES valores: `t, sig, nP`. O `pcall`
                -- acima captura o primeiro em `parts` -- mas esse primeiro
                -- valor e' o ALVO `t`, nao a lista de partes. A lista mora
                -- em `t.parts`.
                --
                -- Com `parts = parts` o pacote mandava o alvo DENTRO de si
                -- mesmo: JSONEncode serializava as 9 chaves do alvo
                -- (hp, parts, team, model, display, kind, maxHp, dead) no
                -- lugar da geometria. Medido: `a.parts.model` = "diogoyzfr1"
                -- (nome do MODELO) e `a.parts.n` = nil -- o servidor descarta
                -- cada "parte" por nao ser um dict com `n`/`p`/`s`/`r`, o
                -- alvo chega ao overlay com partes=0 e NADA e' desenhado.
                --
                -- E era por isso que o `total de partes = 91824` do
                -- instrumento nao aparecia em lugar nenhum: as partes eram
                -- geradas, contadas, e jogadas fora na hora de empacotar.
                parts = parts.parts,
                -- [MOLDE_LINHAS NAO EXISTE]
                --
                -- Este nome nunca e' definido em lugar nenhum do arquivo --
                -- era um global `nil` (confirmado: uma unica ocorrencia, a
                -- que estava aqui). O EFEITO era o esqueleto nao sair: o
                -- overlay recebia o alvo com geometria mas sem os pares de
                -- ossos, entao o desenho de esqueleto ficava vazio.
                --
                -- Os pares corretos ja' vinham calculados dentro do
                -- buildTarget (validando `a.Parent == model` e `b.Parent ==
                -- model`) e estavam em `parts.lines` -- o `parts` aqui e' o
                -- alvo `t`, como explicado acima.
                lines = parts.lines,
            }
            -- ==========================================================
            --  [BUG GRAVE: O CABECALHO CONDICIONAL QUEBRAVA O TIPO DO ALVO]
            -- ==========================================================
            --
            -- Aqui era `if cab.enviar then` -- model/kind/display/team so'
            -- iam na primeira vez, na mudanca e no reenvio de 5 s. A
            -- intencao era economizar bytes (que sao poucos: ~40 B por alvo
            -- por pacote) confiando que o consumidor LEMBRASSE do alvo.
            --
            -- [O CONSUMIDOR NAO LEMBRA. MEDIDO.]
            --
            -- `vs_secure_server.py:855-859` monta a tupla do overlay assim:
            --
            --     clean.append((
            --         str(obj.get('model', ''))[:48],
            --         'player' if obj.get('kind') == 'player' else 'npc',
            --         str(obj.get('display', ''))[:64],
            --         ...
            --
            -- Nao ha' dicionario por `id` em lugar nenhum do servidor -- ele
            -- le' o DICT que chegou e escreve a tupla. Entao, no pacote
            -- "magro":
            --
            --     model   -> None  ->  str(None or '')  ->  ''
            --     kind    -> None  ->  'npc'   ***ERRADO***
            --     display -> None  ->  ''
            --
            -- [E O `kind` ERRADO NAO E' COSMETICO]
            --
            -- `overlay.py:1031-1035` decide o aim por ele:
            --
            --     if kind == 'player':
            --         if not aim_players: continue
            --     elif not aim_npcs:
            --         continue
            --
            -- Em TODO pacote magro o alvo chega como 'npc'. Com o aim de NPC
            -- desligado e o de player ligado, o overlay PARA DE MIRAR EM
            -- JOGADOR entre um reenvio e o seguinte -- e o reenvio e' de 5 s.
            -- Ou seja: 5 s de aim olhando para o lado, 1 pacote certo, mais
            -- 5 s errado. Era esse o defeito, e ele nao aparecia em nenhum
            -- contador porque `a[0]`/`a[1]`/`a[2]` chegavam preenchidos --
            -- com o valor ERRADO.
            --
            -- [A CORRECAO] Manda os quatro sempre. Custo medido: ~40 B por
            -- alvo por pacote; com 12 alvos a 60/s sao ~29 KB/s, contra os
            -- ~120 KB/s que a geometria ja' custa. E' 0,02% do que a
            -- "otimizacao rotacao" ja' economiza (14.149 de 15.867 B).
            --
            -- Economizar bytes que o consumidor nao sabe reconstruir nao e'
            -- otimizacao: e' perder dado.
            -- [SAO JOGADORES -- PALAVRA DO DONO]
            -- Os corpos deste jogo sao 15 jogadores reais (placar medido:
            -- 14 nomes + o dono). O `v.data.owner` e' SEMPRE nil aqui
            -- (GetPlayerFromCharacter falha: os corpos nao sao
            -- Player.Character) e o kind antigo caia em 'npc' -- o overlay
            -- mostrava 'npc' e o nick vira o ID numerico. kind pasa a ser
            -- 'player' SEMPRE; o display, o nick real quando o quadradinho
            -- casou, e o ID do corpo quando nao (melhor do que nada).
            alvo.model = v.modelName
            alvo.kind = "player"
            local nickFresco = MCorpo[v.modelName]
            if nickFresco and (agora - nickFresco.em) < 3 then
                alvo.display = nickFresco.nick
            else
                -- [O CODINOME DO INIMIGO] nick do PLACAR real (pool = roster
                -- - eu - aliados travados - ja' pinados), pinoado UMA vez e
                -- estavel ate o fim da partida. Se o placar nao estiver
                -- legivel, cai no ID do corpo como sempre foi.
                alvo.display = pinInimigo(v.modelName, agora) or v.display
            end
            alvo.team = v.team
            local nUse = nPartes or 0
            local eOrcamento = #targets <= MAX_SIG_PARTS
            if nUse > 6 and not eOrcamento then nUse = 6 end
            for i2 = 1, nUse do
                nS = nS + 1
                sig[nS] = tsig[i2]
            end
            nS = nS + 1
            -- [PAREDE NA ASSINATURA] O veredito tem de estar aqui: com
            -- todo mundo PARADO (eu parado, alvo parado, parede parada)
            -- o pacote inteiro e identico e o portao la no sendBridge
            -- o segura. A virada de parede (alvo saiu de atras da
            -- cobertura, ou entrou) teria de esperar OTRA mudanca
            -- qualquer. Com o token, o flip passa na hora.
            sig[nS] = v.modelName .. "|" .. tostring(v.health) .. "|"
                    .. tostring(v.maxHealth) .. "|" .. (v.deadNow and "1" or "0")
                    .. (deadParede and "P" or "-")
                    .. tostring(nUse)
            if not eOrcamento and nPartes and nPartes > 0 then
                -- A parte 1 e' arbitraria (pairs nao garante ordem), mas
                -- QUALQUER movimento do corpo muda pelo menos uma das
                -- rotacoes, e a primeira que mudar ja' invalida.
                nS = nS + 1
                sig[nS] = tsig[1]
            end
            -- O alvo entra na lista AQUI, depois de completo. Antes isto era
            -- `targets[#targets+1] = {...}` direto na construcao; agora o
            -- cabecalho condicional exige montar primeiro e anexar depois.
            targets[#targets + 1] = alvo
        end
    end

    -- [VIDA] O que MORREU sai do pacote, e isso e' uma mudanca de pacote.
    local nMy = #myIds
    for i = 1, nMy do
        local ok, h, mh, dd = pcall(healthOf, myIds[i])
        if ok then
            if h == nil and dd == nil then dd = true end
            if h == nil or h <= 0 or dd then myFlat[i] = 1 end
        end
    end
    nS = nS + 1
    sig[nS] = "H" .. table.concat(myFlat, "")

    local packet = {
        -- A camera vai junto: sem ela o overlay nao projeta nada.
        camera = camData,
        -- Chaves de time do jogador local, para comparacao.
        myTeam = myKeys,
        -- Sessao: o overlay usa para saber que este cliente esta' vivo.
        client = {name = player.Name, userId = player.UserId},
        targets = targets,
        -- [streamMode] O servidor LE este campo (vs_secure_server.py:453,
        -- packet.get('streamMode', False)) e ecoa no /health. O script nao
        -- mandava, entao o painel mostrava "desligado" para sempre e a
        -- deduplicacao de pacote identico nunca era registrada.
        --
        -- O valor e' sempre true de proposito: este coletor envia a cada
        -- quadro do RenderStepped (60-240/s). Quem decide O QUE desenhar e'
        -- o painel do Windows; isto so' informa o modo de envio.
        streamMode = true,
        -- Diagnostico: se isto cresce, o POST e' o gargalo.
        dropped = bridgeDropped,
        sent = bridgeSent,
        -- [DESEMPENHO] Quantos quadros o portao de assinatura evitou (encode
        -- + POST + copia de CFrame no executor). Com o alvo parado isto
        -- tende ao numero de quadros; se ficar em 0, algo remexe o pacote
        -- todo quadro e o cache nao esta' servindo.
        skipped = bridgeSkipped,
        -- [TEAM CHECK] quantos alvos o filtro barrou neste pacote, e o estado
        -- medido agora (eixo, plano, meu lado, motivo). Sem isso, `targets`
        -- vazio e' indistinguivel de mapa sem inimigo.
        tcFiltrados = tcFiltrados,
        tc = tcEstado(),
        -- [POR QUE O FILTRO ESTA' DESLIGADO] nil = modulo ok.
        tcErro = TC_ERRO,
    }
    if bridgeBuildErr then packet.buildErr = bridgeBuildErr end

    -- [DEVICE COORD] Ultimo bloco calculado. Usa deviceOrigin: o overlay
    -- soma (0,0) do desktop ao viewport e projeta em PIXELS. O overlay
    -- antigo converteria 1920x1080 nativamente, o que quebraria; por isso
    -- este campo so' e' publicado depois do handshake X-VS-DeviceCoord.
    if SUPORTS_DEVICE_COORD then
        local ox, oy = safeLower("left")
        local ux, uy = safeLower("top")
        local vmin = cam[1]
        local vmax = cam[2]
        if math.abs(vmin) <= 16 and math.abs(vmax) <= 16 then
            -- Matriz degenerada (bug do executor no MultiView): cai para a
            -- viewport nativa em vez de projetar lixo.
            device = {x1 = 0, y1 = 0, x2 = vp[1], y2 = vp[2]}
        else
            device = {
                x1 = math.floor(math.abs(vmin) * vp[1] + 0.5),
                y1 = math.floor(math.abs(vmax) * vp[2] + 0.5),
                x2 = math.floor(math.abs(ux) * vp[1] + 0.5),
                y2 = math.floor(math.abs(uy) * vp[2] + 0.5),
            }
        end
        packet.device = device
    end

    -- [DIAGNOSE VIVA EM DISCO -- 1x a cada 2 s, arquivo fixo]
    --
    -- Por que existe: as injecoes do Xeno NAO compartilham `_G` -- a sonda
    -- externa mediu `_G.TC = nil` com o coletor vivo (SONDA_TC_ESTADO_1,
    -- 18:42). Entao o estado do modulo so' pode ser lido por quem roda NA
    -- MESMA execucao: o proprio coletor. Isto aqui despeja, 2 s em 2 s,
    -- um ARQUIVO FIXO (sobrescrito -- nao cresce, nao e' o marco por quadro
    -- que chegou a 258 KB) com o retalho completo:
    --
    --   alvos=     quantos alvos entraram neste pacote
    --   filtrados= quantos o team check barrou (aliado travado)
    --   erros=     quantos pcalls do filtro estouraram
    --   zonas=     zonas varridas   |  aliadas= cadeia formada
    --   origem=    a minha primeira zona (a ancora do lado)
    --   classificados= corpos travados na sessao | memoria= tamanho da tabela
    --   motivo=    o motivo corrente da maquina de estado
    --   tcErro=    nil quando o modulo carregou de verdade
    --
    -- Escrevendo na thread do build (2 s em 2 s) o custo e' desprezivel.
    local agoraDump = os.clock()
    if not tcVivoUlt or agoraDump - tcVivoUlt >= 2 then
        tcVivoUlt = agoraDump
        pcall(function()
            local est = tcEstado()
            local nCorpos = 0
            for _ in pairs(tracked) do nCorpos = nCorpos + 1 end

            -- [AMOSTRA CRUA DA PROJECAO] o primeiro corpo de `vivos`, uma
            -- vez por despejo (a cada 2 s): onde o `head` projeta, o que o
            -- `onScreen` diz e o tamanho do viewport. Distingue "nao tem
            -- ninguem na tela" (on=false com valor fora da tela, ou corpo
            -- muito longe do plano) de "o W2V esta' quebrado no executor"
            -- (okW=false, ou sp sem X).
            local amostra = "-"
            local primeiro = vivos[1]
            if primeiro then
                local okC, cab = pcall(function()
                    return primeiro.model and primeiro.model:FindFirstChild("head", true)
                end)
                if okC and cab then
                    local okP, pp = pcall(function() return cab.Position end)
                    if okP and pp and pp.X then
                        local okW, sp, on = pcall(function()
                            return camera and camera:WorldToViewportPoint(pp)
                        end)
                        if okW and sp and sp.X then
                            amostra = string.format("x=%.0f y=%.0f z=%.0f on=%s",
                                sp.X, sp.Y, sp.Z, tostring(on))
                        elseif okW then
                            amostra = "sp_impar=" .. tostring(sp)
                        else
                            amostra = "W2V_ERRO: " .. tostring(sp)
                        end
                    else
                        amostra = "head_sem_pos"
                    end
                else
                    amostra = "sem_head"
                end
            end

            -- [A LISTA DAS ZONAS NO DUMP] via TC.zonas(): nome (12 chars),
            -- pos/10 e o selo dS/dn (o "eu" de EST.meuPos esta' DENTRO da
            -- caixa?). container exato do dentroDaCaixa, espelhado aqui
            -- porque o buildPacket nao ve os locais do modulo.
            local lista = ""
            local meuP = est.meuPos
            if TC and type(TC.zonas) == "function" then
                local okZ, zs = pcall(TC.zonas)
                if okZ and type(zs) == "table" then
                    for i = 1, #zs do
                        local z = zs[i]
                        local nome = tostring(z.nome or "?")
                        if #nome > 12 then nome = string.sub(nome, 1, 12) end
                        local dent = "dn"
                        if meuP and z.pos and z.tam
                           and math.abs(meuP[1] - z.pos[1]) <= z.tam[1] * 0.5
                           and math.abs(meuP[2] - z.pos[2]) <= z.tam[2] * 0.5
                           and math.abs(meuP[3] - z.pos[3]) <= z.tam[3] * 0.5 then
                            dent = "dS"
                        end
                        lista = lista .. "[" .. nome .. "@" ..
                            string.format("%.0f,%.0f,%.0f", z.pos[1] or 0, z.pos[2] or 0, z.pos[3] or 0)
                            .. "|" .. string.format("%.0fx%.0fx%.0f",
                                (z.tam and z.tam[1]) or 0, (z.tam and z.tam[2]) or 0, (z.tam and z.tam[3]) or 0)
                            .. dent .. "]"
                    end
                end
            end

            -- [A MEMORIA DO TC NO DUMP] quem esta' travado e de que lado:
            -- mem=NOME:1(aliado)/0(inimigo)/-(pendente limitado a 12). E'
            -- o que decide se um "aliado desenhado" e' pendente ou foi
            -- travado no lado errado.
            local memTxt = ""
            if TC and type(TC.memoria) == "function" then
                local okM, mem = pcall(TC.memoria)
                if okM and type(mem) == "table" then
                    local nM = 0
                    for _, m in ipairs(mem) do
                        if nM >= 12 then break end
                        nM = nM + 1
                        local nm = tostring(m.nome or "?")
                        if #nm > 8 then nm = string.sub(nm, 1, 8) end
                        local lado = "-"
                        if m.aliado == true then lado = "1"
                        elseif m.aliado == false then lado = "0" end
                        memTxt = memTxt .. nm .. ":" .. lado .. " "
                    end
                end
            end

            writefile("coletor_tc_vivo.txt",
                "t=" .. os.time()
                .. " alvos=" .. #targets
                .. " vivos=" .. cVivos
                .. " troncoFora=" .. cTroncoFora
                .. " ossoFora=" .. cOssoFora
                .. " frenteFora=" .. cFrenteFora
                .. " filtrados=" .. tcFiltrados
                .. " erros=" .. tcErrosFiltro
                .. " corpos=" .. nCorpos
                .. " osso1=" .. amostra
                .. " tela=" .. tostring(vp[1]) .. "x" .. tostring(vp[2])
                .. " zonas=" .. tostring(est.nZonas)
                .. " aliadas=" .. tostring(est.nAliadas)
                .. " origem=" .. tostring(est.origem)
                .. " classificados=" .. tostring(est.nClassificados)
                .. " memoria=" .. tostring(est.nMemoria)
                .. " motivo=" .. tostring(est.motivo)
                .. " eu=" .. tostring(est.meuSrc)
                .. "@" .. string.format("%.0f,%.0f,%.0f",
                    (est.meuPos and est.meuPos[1]) or 0,
                    (est.meuPos and est.meuPos[2]) or 0,
                    (est.meuPos and est.meuPos[3]) or 0)
                .. " zL=" .. lista
                .. " mem=" .. memTxt
                .. " nick=" .. tostring(cNickAliado)
                .. " marc=" .. tostring(MLote and #MLote or -1)
                .. " mlok=" .. tostring(MLockN) .. "/" .. tostring(MLockC)
                .. " pin=" .. (function()
                    local nPin = 0
                    for _ in pairs(MPIN) do nPin = nPin + 1 end
                    return tostring(nPin)
                end)()
                .. " wall=" .. tostring(wBloqParede)
                .. " diag=" .. tostring(diagUltimo)
                .. " tcErro=" .. tostring(TC_ERRO))
        end)
    end

    return packet, table.concat(sig, "\1")
end

-- =====================================================================
-- 9. LOOP PRINCIPAL
-- =====================================================================
-- Prioridade Camera+1: roda depois da camera do quadro, entao a matriz
-- enviada e' a que o jogador esta' vendo neste instante.
-- [NOME UNICO POR EXECUCAO -- A CAUSA DO LOOP MORTO]
--
-- O nome era CONSTANTE ("CharacterBoundsUpdate") e o UnbindFromRenderStep
-- e' POR NOME no Roblox. Medido nesta sessao: mais de dez injecoes do
-- coletor, e o `received` do servidor nunca saiu de 11164. O marco de
-- etapa provou que o script RODA ATE A ULTIMA LINHA, e mesmo assim zero
-- pacote -- porque o callback do RenderStep nunca dispara.
--
-- Mecanismo: cada execucao nova chama `cleanup()` da anterior (registro na
-- ultima linha). Se QUALQUER execucao anterior nao chegou a registrar o
-- `stop`, ela fica orfa; e como o nome e' o mesmo, o proximo
-- `UnbindFromRenderStep` derruba o bind que acabou de nascer. O sintoma e'
-- exatamente o medido: script roda inteiro, `received` parado, `skipped`
-- parado, nenhum erro em lugar nenhum.
--
-- Agora cada execucao tem o SEU nome, e `cleanup` desfaz SO' o seu.
local _NOME_BIND = "MATRIX_COL_" .. tostring(math.floor(os.clock() * 1000))
local ESP_RENDER_NAME = _NOME_BIND
local nextAimPartAt = 0
local myKeysCache, myKeysAt = nil, 0

-- [A ORDEM IMPORTA -- BUG CORRIGIDO]
-- Este bloco vira uma FUNCAO em vez de registrar direto. Motivo, medido:
--
--   O `cleanup()` da secao 10 faz `UnbindFromRenderStep(ESP_RENDER_NAME)`.
--   O nome e' CONSTANTE. Quando o script era reexecutado (o executor reinjeta
--   a cada sessao, e o usuario pode rodar duas vezes), a sequencia era:
--
--      1533  BindToRenderStep(ESP_RENDER_NAME, ...)     <- registra o NOVO
--      1614  cleanup()  -> UnbindFromRenderStep(...)    <- DESREGISTRA o NOVO
