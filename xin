local function registerPlayer(other)
    if other == player then return end
    if other.Character then registerModel(other.Character) end
    -- [CACHE] Sortir um jogador tira o antigo e poe o novo: o pacote tem de
    -- sair, senao o overlay ficaria com o layout do corpo anterior.
    connect(other.CharacterAdded, function()
        bridgeLastSig = nil
    end)
    connect(other.CharacterAdded, function(character)
        task.defer(function() registerModel(character) end)
    end)
end
connect(Players.PlayerAdded, registerPlayer)
connect(Players.PlayerRemoving, function(other)
    for model, data in pairs(tracked) do
        if data.owner == other then removeModel(model) end
    end
end)

connect(Workspace.DescendantAdded, function(inst)
    if inst:IsA("Model") then
        registerModel(inst)
    elseif inst:IsA("Humanoid") or (inst:IsA("BasePart") and inst.Name == "HumanoidRootPart") then
        local model = inst:FindFirstAncestorOfClass("Model")
        if model then registerModel(model) end
    end
end)
connect(Workspace.DescendantRemoving, function(inst)
    if tracked[inst] and not inst.Parent then removeModel(inst) end
end)

for _, other in ipairs(Players:GetPlayers()) do registerPlayer(other) end

-- [DESEMPENHO] A varredura inicial do Workspace era SINCRONA, aqui mesmo no
-- corpo do script:
--
--     for _, inst in ipairs(Workspace:GetDescendants()) do ... end
--
-- Quando o executor injeta, o Roblox congela ate' esse laco terminar. O
-- comentario que existia aqui falava de um "teto de tempo" que NUNCA existiu
-- no codigo: nao havia fatia nem yield nenhum. Num mapa grande, com dezenas
-- de milhares de descendentes mais um FindFirstChild x3 por Model, isso e'
-- um travamento unico e visivel bem no momento em que se liga o overlay.
--
-- Agora roda em task.spawn, em LOTES, cedendo o quadro a cada SCAN_BATCH.
-- O jogo continua responsivo e o registro termina em alguns quadros.
local SCAN_BATCH = 400

task.spawn(function()
    local desc = Workspace:GetDescendants()
    local n = #desc
    for i = 1, n do
        if i % SCAN_BATCH == 0 then
            task.wait()          -- devolve o quadro ao Roblox
        end
        local inst = desc[i]
        if inst:IsA("Model") then registerModel(inst) end
    end
end)

-- Varredura extra de pastas de personagem. Alem da varredura acima (que ja'
-- cobre tudo), alguns jogos guardam os corpos em pastas dedicadas. Registrar
-- explicitamente garante que eles entram mesmo que a varredura geral ainda
-- nao tenha chegado neles.
--   Workspace.Characters  -- usado por varios jogos de treino/arena
task.spawn(function()
    for _, nomePasta in ipairs({"Characters", "characters", "PlayerCharacters", "Bots",
                                "NPCs", "Mobs", "Entities"}) do
        local pasta = Workspace:FindFirstChild(nomePasta)
        if pasta then
            local lista = pasta:GetDescendants()
            for i = 1, #lista do
                if i % SCAN_BATCH == 0 then task.wait() end
                local inst = lista[i]
                if inst:IsA("Model") then registerModel(inst) end
            end
        end
    end
end)

